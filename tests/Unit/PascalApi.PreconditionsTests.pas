unit PascalApi.PreconditionsTests;

{ Tests for PascalApi.Preconditions: the version's entity tag and If-Match
  (RFC 9110, section 13.1.1): absent, "*", a list with blanks and empty
  elements, strong comparison (a weak tag never matches), the syntax
  refused, and the status and code each answer becomes.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  PascalApi.DUnitXCompat,
  SysUtils,
  PascalApi.Http,
  PascalApi.Preconditions;

type
  [TestFixture]
  TPreconditionsTests = class
  public
    [Test] procedure VersionETag_Quoted;
    [Test] procedure Evaluate_AbsentAndAny;
    [Test] procedure Evaluate_StrongMatchInList;
    [Test] procedure Evaluate_WeakNeverMatches;
    [Test] procedure Evaluate_InvalidSyntax;
    [Test] procedure Require_StatusAndCode;
    [Test] procedure Failed_NamesTheCurrentTag;
  end;

implementation

// RequireIfMatch's outcome: 'none' or '<status> <code>'.
function IfMatchAnswer(const AHeader, ACurrent: string; AAcceptAny: Boolean): string;
begin
  Result := 'none';
  try
    RequireIfMatch(AHeader, ACurrent, AAcceptAny);
  except
    on E: EHttpException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Code;
  end;
end;

function SentAnswer(const AHeader: string): string;
begin
  Result := 'none';
  try
    RequireIfMatchSent(AHeader);
  except
    on E: EHttpException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Code;
  end;
end;

procedure TPreconditionsTests.VersionETag_Quoted;
begin
  TAssert.AssertEquals('"1"', VersionETag(1));
  TAssert.AssertEquals('"42"', VersionETag(42));
end;

procedure TPreconditionsTests.Evaluate_AbsentAndAny;
begin
  TAssert.AssertTrue('empty', EvaluateIfMatch('', '"1"') = imAbsent);
  TAssert.AssertTrue('blanks', EvaluateIfMatch(' '#9' ', '"1"') = imAbsent);
  TAssert.AssertTrue('star', EvaluateIfMatch('*', '"1"') = imAny);
  TAssert.AssertTrue('star with blanks', EvaluateIfMatch(' * ', '"1"') = imAny);
end;

procedure TPreconditionsTests.Evaluate_StrongMatchInList;
begin
  TAssert.AssertTrue('alone', EvaluateIfMatch('"3"', '"3"') = imMatch);
  TAssert.AssertTrue('other', EvaluateIfMatch('"2"', '"3"') = imNoMatch);
  TAssert.AssertTrue('in a list', EvaluateIfMatch('"1", "3"', '"3"') = imMatch);
  TAssert.AssertTrue('list without it', EvaluateIfMatch('"1","2"', '"3"') = imNoMatch);
  TAssert.AssertTrue('empty elements', EvaluateIfMatch(' , "3" ,, ', '"3"') = imMatch);
  TAssert.AssertTrue('prefix is not equal', EvaluateIfMatch('"31"', '"3"') = imNoMatch);
  TAssert.AssertTrue('syntax only', EvaluateIfMatch('"3"', '') = imNoMatch);
  TAssert.AssertTrue('empty tag', EvaluateIfMatch('""', '""') = imMatch);
end;

procedure TPreconditionsTests.Evaluate_WeakNeverMatches;
begin
  TAssert.AssertTrue('weak', EvaluateIfMatch('W/"3"', '"3"') = imNoMatch);
  TAssert.AssertTrue('weak, then strong', EvaluateIfMatch('W/"3", "3"', '"3"') = imMatch);
end;

procedure TPreconditionsTests.Evaluate_InvalidSyntax;
begin
  TAssert.AssertTrue('no quotes', EvaluateIfMatch('3', '"3"') = imInvalid);
  TAssert.AssertTrue('unclosed', EvaluateIfMatch('"3', '"3"') = imInvalid);
  TAssert.AssertTrue('space inside', EvaluateIfMatch('"3 4"', '"3 4"') = imInvalid);
  TAssert.AssertTrue('no comma', EvaluateIfMatch('"1" "3"', '"3"') = imInvalid);
  TAssert.AssertTrue('star in a list', EvaluateIfMatch('*, "3"', '"3"') = imInvalid);
  TAssert.AssertTrue('lower w', EvaluateIfMatch('w/"3"', '"3"') = imInvalid);
  TAssert.AssertTrue('only commas', EvaluateIfMatch(' , ,', '"3"') = imInvalid);
end;

procedure TPreconditionsTests.Require_StatusAndCode;
begin
  TAssert.AssertEquals('none', IfMatchAnswer('"3"', '"3"', False));
  TAssert.AssertEquals('428 precondition_required', IfMatchAnswer('', '"3"', False));
  TAssert.AssertEquals('428 precondition_required', IfMatchAnswer('*', '"3"', False));
  TAssert.AssertEquals('none', IfMatchAnswer('*', '"3"', True));
  TAssert.AssertEquals('400 invalid_if_match', IfMatchAnswer('3', '"3"', False));
  TAssert.AssertEquals('412 precondition_failed', IfMatchAnswer('"2"', '"3"', False));
  TAssert.AssertEquals('412 precondition_failed', IfMatchAnswer('W/"3"', '"3"', False));
  TAssert.AssertEquals('none', SentAnswer('"2"'));
  TAssert.AssertEquals('428 precondition_required', SentAnswer(''));
  TAssert.AssertEquals('400 invalid_if_match', SentAnswer('2'));
end;

procedure TPreconditionsTests.Failed_NamesTheCurrentTag;
var
  LMessage: string;
begin
  LMessage := '';
  try
    RequireIfMatch('"2"', '"3"');
  except
    on E: EHttpException do
      LMessage := E.Message;
  end;
  TAssert.AssertEquals('The resource changed since you read it: read it again ' +
    '(its ETag is now "3").', LMessage);
  LMessage := '';
  try
    RaisePreconditionFailed;
  except
    on E: EHttpException do
      LMessage := IntToStr(E.StatusCode) + ' ' + E.Code;
  end;
  TAssert.AssertEquals('412 precondition_failed', LMessage);
end;

initialization
  TDUnitX.RegisterTestFixture(TPreconditionsTests);

end.
