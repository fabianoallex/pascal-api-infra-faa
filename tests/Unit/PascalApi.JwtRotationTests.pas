unit PascalApi.JwtRotationTests;

(* Tests for phase 2 of docs/jwt-keys-design.md in PascalApi.JwtKeys: the
  rotating key ring (the first key, a whole rotation with its pending,
  signing, verifying and gone states, two instances on one store, an
  instance losing the race for generation n+1, a store that is down after
  startup, a corrupt store, an unknown kid that doesn't reach the store),
  TMemoryJwtKeyStore, and TDbJwtKeyStore against pascal-db-faa's
  TMockDBFactory (its SQL names and parameters, a unique violation as
  TryAdd's False, any other error raised); and phase 3, PascalApi.Tenancy's
  TTenantJwtKeyRing (a key per tenant, a tenant's key refused for another
  tenant's claim, a kid naming an unknown tenant answered without a query,
  a tenant added to the catalog later). TTestCatalog is a catalog the test
  changes and counts. Sealed secrets: TAesGcmSecretCipher (JWT_KEYS_MASTER_KEY,
  master key rotation, a value sealed by OpenSSL through Python's
  cryptography opened here) and TSealedJwtKeyStore (sealed in the store,
  plain in the ring, plain rows accepted or refused, a sealed secret moved
  to another row refused).

  Time is the test's: a fixed wall clock in TClock (TJwt.UnixNow, what the
  keys' dates use) and a manual TTicker (the reload interval), moved
  together by Advance. TTestStore wraps a memory store to count loads, fail
  on demand, and play another instance that stores the next generation
  first.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. *)

interface

uses
  DUnitX.TestFramework,
  PascalApi.DUnitXCompat,
  SysUtils,
  DateUtils,
  Variants,
  PascalCommon.SystemContext,
  PascalJsonMapper.Json,
  PascalDb.Interfaces,
  PascalDb.Mock,
  PascalApi.Jwt,
  PascalApi.JwtKeys,
  PascalApi.Tenancy;

type
  TRotationClock = class(TInterfacedObject, IClock)
  public
    function Now: TDateTime;
    function Date: TDateTime;
  end;

  TRotationTicker = class(TInterfacedObject, ITicker)
  public
    function NowMs: UInt64;
  end;

  /// A memory store that counts Load calls, fails while Failing, and with
  /// RaceNext stores a competitor's key of the same generation just before
  /// the next TryAdd (another instance winning the rotation).
  TTestStore = class(TInterfacedObject, IJwtKeyStore)
  private
    FInner: IJwtKeyStore;
  public
    LoadCount: Integer;
    Failing: Boolean;
    RaceNext: Boolean;
    RaceKid: string;
    constructor Create;
    function Load(const AScope: string): TJwtKeyArray;
    function TryAdd(const AScope: string; const AKey: TJwtKey): Boolean;
    procedure Delete(const AScope, AKid: string);
    function Inner: IJwtKeyStore;
  end;

  /// A catalog the test changes (Add) and counts (FindCount, AllCount).
  TTestCatalog = class(TInterfacedObject, ITenantCatalog)
  public
    Ids: array of string;
    FindCount, AllCount: Integer;
    procedure Add(const AId: string);
    function Find(const AId: string; out AInfo: TTenantInfo): Boolean;
    function All: TArray<TTenantInfo>;
  end;

  TErrorSink = class
  public
    Lines: string;
    procedure Log(const ALine: string);
  end;

  [TestFixture]
  TJwtRotationTests = class
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure FirstKey_SignsAtOnce;
    [Test] procedure FullRotation_OldTokensKeepVerifying;
    [Test] procedure TwoInstances_OneStore;
    [Test] procedure LosingTheRace_UsesTheWinnersKey;
    [Test] procedure StoreDownAfterStartup_KeysStayInUse;
    [Test] procedure StoreDownAtStartup_Raises;
    [Test] procedure CorruptStore_Raises;
    [Test] procedure UnknownKid_DoesNotReachTheStore;
    [Test] procedure Options_Validated;
    [Test] procedure Scope_PrefixesTheKid;
    [Test] procedure Sign_HonoursMaxTokenSeconds;
    [Test] procedure LegacySecret_ForTokensWithoutKid;
    [Test] procedure MemoryStore_Rules;
  end;

  [TestFixture]
  TTenantJwtKeyRingTests = class
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure EachTenant_ItsOwnKey;
    [Test] procedure TenantsKey_RefusedForAnotherTenantsClaim;
    [Test] procedure UnknownTenantKid_NoQuery;
    [Test] procedure Sign_NeedsAKnownTenant;
    [Test] procedure TenantAddedLater;
    [Test] procedure LegacyAndMalformedKids;
    [Test] procedure Rotation_PerTenant;
  end;

  [TestFixture]
  TSealedSecretTests = class
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure MasterKeys_Parsed;
    [Test] procedure MasterKeys_Invalid;
    [Test] procedure Seal_ThenOpen;
    [Test] procedure Open_OpenSslSealedValue;
    [Test] procedure Open_RefusesAnotherContextOrKey;
    [Test] procedure MasterKeyRotation;
    [Test] procedure Store_SealsAndOpens;
    [Test] procedure Store_PlainRows;
    [Test] procedure Store_SecretMovedToAnotherRow;
    [Test] procedure Ring_OnASealedStore;
  end;

  [TestFixture]
  TDbJwtKeyStoreTests = class
  public
    [Test] procedure Load_ReadsTheColumns;
    [Test] procedure TryAdd_PassesTheKey;
    [Test] procedure TryAdd_UniqueViolation_IsFalse;
    [Test] procedure TryAdd_OtherErrors_Raise;
    [Test] procedure Delete_PassesScopeAndKid;
    [Test] procedure Ring_OnTheDbStore;
  end;

implementation

const
  START = 1700000000;

var
  GNow: Int64;
  GTickMs: UInt64;

procedure Advance(ASeconds: Int64);
begin
  Inc(GNow, ASeconds);
  Inc(GTickMs, UInt64(ASeconds) * 1000);
end;

function Options: TJwtRotationOptions;
begin
  Result := TJwtRotationOptions.Default;
  Result.RotateEverySeconds := 1000;
  Result.PropagationSeconds := 60;
  Result.MaxTokenSeconds := 600;
  Result.ReloadSeconds := 10;
end;

function Claims(AExp: Int64): string;
begin
  Result := Format('{"sub":"ana","exp":%d}', [AExp]);
end;

function KidOf(const AToken: string): string;
begin
  if TJwt.ReadKid(AToken, Result) <> jrValid then
    Result := '<malformed>';
end;

function SigningKid(const ARing: IJwtKeyRing): string;
var
  LKey: TJwtKey;
begin
  if ARing.SigningKey(nil, LKey) then
    Result := LKey.Kid
  else
    Result := '<none>';
end;

function DecodeWith(const ARing: IJwtKeyRing; const AToken: string): TJwtResult;
var
  LClaims: TJsonValue;
begin
  Result := TJwtKeys.Decode(ARing, AToken, LClaims);
  LClaims.Free;
end;

function IsHex(const AText: string): Boolean;
var
  I: Integer;
begin
  Result := AText <> '';
  for I := 1 to Length(AText) do
    if not CharInSet(AText[I], ['0'..'9', 'a'..'f']) then
      Exit(False);
end;

function CreateError(const AStore: IJwtKeyStore; const AOptions: TJwtRotationOptions;
  const AScope: string): string;
var
  LRing: IJwtKeyRing;
begin
  Result := '';
  try
    LRing := TRotatingJwtKeyRing.Create(AStore, AOptions, AScope);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

// Constructors into interface variables: an interfaced object used straight
// from Create (TX.Create(...).Method, or passed to a const parameter) never
// gets a reference, so it is never released (heaptrc showed the store and
// the mock it held).
function NewRing(const AStore: IJwtKeyStore; const AOptions: TJwtRotationOptions;
  const AScope: string = ''): IJwtKeyRing;
begin
  Result := TRotatingJwtKeyRing.Create(AStore, AOptions, AScope);
end;

function DbStore(const AFactory: IDBFactory; const ALoadSql: string = 'JWT_KEY.BY_TENANT';
  const AAddSql: string = 'JWT_KEY.INSERT'; const ADeleteSql: string = 'JWT_KEY.DELETE'): IJwtKeyStore;
begin
  Result := TDbJwtKeyStore.Create(AFactory, ALoadSql, AAddSql, ADeleteSql);
end;

function StoredKey(AGeneration: Integer; const AKid, ASecret: string;
  AActiveFrom: Int64): TJwtKey;
begin
  Result := TJwtKey.Create(AKid, ASecret);
  Result.Generation := AGeneration;
  Result.CreatedAt := AActiveFrom;
  Result.ActiveFrom := AActiveFrom;
end;

{ TRotationClock }

function TRotationClock.Now: TDateTime;
begin
  Result := UnixToDateTime(GNow, False);
end;

function TRotationClock.Date: TDateTime;
begin
  Result := Trunc(Now);
end;

{ TRotationTicker }

function TRotationTicker.NowMs: UInt64;
begin
  Result := GTickMs;
end;

{ TTestStore }

constructor TTestStore.Create;
begin
  inherited Create;
  FInner := TMemoryJwtKeyStore.Create;
end;

function TTestStore.Load(const AScope: string): TJwtKeyArray;
begin
  Inc(LoadCount);
  if Failing then
    raise EInOutError.Create('store down');
  Result := FInner.Load(AScope);
end;

function TTestStore.TryAdd(const AScope: string; const AKey: TJwtKey): Boolean;
var
  LOther: TJwtKey;
begin
  if Failing then
    raise EInOutError.Create('store down');
  if RaceNext then
  begin
    RaceNext := False;
    LOther := AKey;
    LOther.Kid := RaceKid;
    LOther.Secret := 'the-other-instance-secret';
    FInner.TryAdd(AScope, LOther);
  end;
  Result := FInner.TryAdd(AScope, AKey);
end;

procedure TTestStore.Delete(const AScope, AKid: string);
begin
  if Failing then
    raise EInOutError.Create('store down');
  FInner.Delete(AScope, AKid);
end;

function TTestStore.Inner: IJwtKeyStore;
begin
  Result := FInner;
end;

{ TTestCatalog }

procedure TTestCatalog.Add(const AId: string);
begin
  SetLength(Ids, Length(Ids) + 1);
  Ids[High(Ids)] := AId;
end;

function TTestCatalog.Find(const AId: string; out AInfo: TTenantInfo): Boolean;
var
  I: Integer;
begin
  Inc(FindCount);
  AInfo := Default(TTenantInfo);
  for I := 0 to High(Ids) do
    if Ids[I] = AId then
    begin
      AInfo.Id := AId;
      Exit(True);
    end;
  Result := False;
end;

function TTestCatalog.All: TArray<TTenantInfo>;
var
  I: Integer;
begin
  Inc(AllCount);
  Result := nil;
  SetLength(Result, Length(Ids));
  for I := 0 to High(Ids) do
  begin
    Result[I] := Default(TTenantInfo);
    Result[I].Id := Ids[I];
  end;
end;

{ TErrorSink }

procedure TErrorSink.Log(const ALine: string);
begin
  Lines := Lines + ALine + #10;
end;

{ TJwtRotationTests }

procedure TJwtRotationTests.Setup;
begin
  GNow := START;
  GTickMs := 5000000;
  TClock.SetClock(TRotationClock.Create);
  TTicker.SetTicker(TRotationTicker.Create);
end;

procedure TJwtRotationTests.TearDown;
begin
  TClock.Reset;
  TTicker.Reset;
end;

procedure TJwtRotationTests.FirstKey_SignsAtOnce;
var
  LStore: IJwtKeyStore;
  LRing: TRotatingJwtKeyRing;
  LRingRef: IJwtKeyRing;
  LKeys: TJwtKeyArray;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LRing := TRotatingJwtKeyRing.Create(LStore, Options);
  LRingRef := LRing;
  LKeys := LRing.Keys;
  TAssert.AssertEquals('one key', 1, Length(LKeys));
  TAssert.AssertEquals('generation', 1, LKeys[0].Generation);
  TAssert.AssertEquals('active now', Int64(START), LKeys[0].ActiveFrom);
  TAssert.AssertEquals('no end', Int64(0), LKeys[0].NotAfter);
  TAssert.AssertTrue('kid: 16 hex digits ' + LKeys[0].Kid,
    (Length(LKeys[0].Kid) = 16) and IsHex(LKeys[0].Kid));
  // 32 bytes in Base64url, without padding.
  TAssert.AssertEquals('secret length', 43, Length(LKeys[0].Secret));
  TAssert.AssertEquals('stored', 1, Length(LStore.Load('')));
  TAssert.AssertEquals(LKeys[0].Kid, KidOf(TJwtKeys.Sign(LRingRef, Claims(START + 60))));
  // A second ring on the same store adds nothing: it reads the first key.
  TAssert.AssertEquals('another instance', LKeys[0].Kid,
    SigningKid(NewRing(LStore, Options)));
  TAssert.AssertEquals('still one key', 1, Length(LStore.Load('')));
end;

procedure TJwtRotationTests.FullRotation_OldTokensKeepVerifying;
var
  LStore: IJwtKeyStore;
  LRing: TRotatingJwtKeyRing;
  LRingRef: IJwtKeyRing;
  LKid1, LKid2, LOldToken, LNewToken: string;
  LKeys: TJwtKeyArray;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LRing := TRotatingJwtKeyRing.Create(LStore, Options);
  LRingRef := LRing;
  LKid1 := SigningKid(LRingRef);

  // RotateEverySeconds later: generation 2 is stored, pending for 60 s.
  Advance(1000);
  TAssert.AssertEquals('k1 still signs while k2 is pending', LKid1, SigningKid(LRingRef));
  LKeys := LRing.Keys;
  TAssert.AssertEquals('two keys', 2, Length(LKeys));
  LKid2 := LKeys[1].Kid;
  TAssert.AssertEquals('k2 pending until', Int64(START + 1060), LKeys[1].ActiveFrom);
  TAssert.AssertEquals('k1 verifies until k2 + MaxTokenSeconds', Int64(START + 1660),
    LKeys[0].NotAfter);
  // The last token of k1: exp as far as MaxTokenSeconds allows.
  LOldToken := TJwtKeys.Sign(LRingRef, Claims(GNow + 600));
  TAssert.AssertEquals(LKid1, KidOf(LOldToken));
  // A pending key already verifies (another instance may sign with it first).
  TAssert.AssertEquals('pending k2 verifies', Ord(jrValid),
    Ord(DecodeWith(LRingRef, TJwt.SignHS256(Claims(GNow + 60), LKeys[1].Secret, LKid2))));

  Advance(59);
  TAssert.AssertEquals('one second before k2', LKid1, SigningKid(LRingRef));
  Advance(1);
  TAssert.AssertEquals('k2 signs', LKid2, SigningKid(LRingRef));
  LNewToken := TJwtKeys.Sign(LRingRef, Claims(GNow + 600));
  TAssert.AssertEquals(LKid2, KidOf(LNewToken));
  TAssert.AssertEquals('the old token still verifies', Ord(jrValid),
    Ord(DecodeWith(LRingRef, LOldToken)));

  // k1 verifies up to its NotAfter (START + 1660), not one second more,
  // with or without a reload; the next reload drops it from the ring and
  // the store. (LOldToken expired first, at START + 1600.)
  LOldToken := TJwt.SignHS256(Claims(START + 4000), LKeys[0].Secret, LKid1);
  Advance(1659 - 1060);
  TAssert.AssertEquals('k1, one second before its end', Ord(jrValid),
    Ord(DecodeWith(LRingRef, LOldToken)));
  TAssert.AssertEquals('k1 still in the ring', 2, Length(LRing.Keys));
  Advance(1);
  TAssert.AssertEquals('k1 at its end', Ord(jrBadSignature), Ord(DecodeWith(LRingRef, LOldToken)));
  Advance(10);
  SigningKid(LRingRef); // a request after ReloadSeconds: reload
  TAssert.AssertEquals('k1 dropped', 1, Length(LRing.Keys));
  TAssert.AssertEquals('k1 deleted from the store', 1, Length(LStore.Load('')));
  TAssert.AssertEquals('k2 verifies', Ord(jrValid),
    Ord(DecodeWith(LRingRef, TJwtKeys.Sign(LRingRef, Claims(GNow + 60)))));
  TAssert.AssertEquals(LKid2, SigningKid(LRingRef));
end;

procedure TJwtRotationTests.TwoInstances_OneStore;
var
  LStore: IJwtKeyStore;
  LA, LB: IJwtKeyRing;
  LToken: string;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LA := TRotatingJwtKeyRing.Create(LStore, Options);
  LB := TRotatingJwtKeyRing.Create(LStore, Options);
  TAssert.AssertEquals('same first key', SigningKid(LA), SigningKid(LB));
  Advance(1000);
  SigningKid(LA); // A rotates
  SigningKid(LB); // B reloads: k2 exists, not due again
  TAssert.AssertEquals('one rotation for two instances', 2, Length(LStore.Load('')));
  Advance(60);
  LToken := TJwtKeys.Sign(LA, Claims(GNow + 60));
  // B loaded k2 within ReloadSeconds of its creation (PropagationSeconds >=
  // ReloadSeconds): it verifies A's first token signed with k2.
  TAssert.AssertEquals('B verifies A''s new key', Ord(jrValid), Ord(DecodeWith(LB, LToken)));
  TAssert.AssertEquals('both sign with k2', SigningKid(LA), SigningKid(LB));
end;

procedure TJwtRotationTests.LosingTheRace_UsesTheWinnersKey;
var
  LStore: TTestStore;
  LStoreRef: IJwtKeyStore;
  LRing: IJwtKeyRing;
begin
  LStore := TTestStore.Create;
  LStoreRef := LStore;
  LRing := TRotatingJwtKeyRing.Create(LStoreRef, Options);
  Advance(1000);
  LStore.RaceNext := True;
  LStore.RaceKid := 'aaaaaaaaaaaaaaaa';
  SigningKid(LRing); // tries generation 2, loses, reads the winner's
  Advance(60);
  TAssert.AssertEquals('the winner''s key signs', 'aaaaaaaaaaaaaaaa', SigningKid(LRing));
  TAssert.AssertEquals('one generation 2', 2, Length(LStore.Inner.Load('')));
end;

procedure TJwtRotationTests.StoreDownAfterStartup_KeysStayInUse;
var
  LStore: TTestStore;
  LStoreRef: IJwtKeyStore;
  LRing: TRotatingJwtKeyRing;
  LRingRef: IJwtKeyRing;
  LSink: TErrorSink;
  LKid: string;
  LLoads: Integer;
begin
  LSink := TErrorSink.Create;
  try
    LStore := TTestStore.Create;
    LStoreRef := LStore;
    LRing := TRotatingJwtKeyRing.Create(LStoreRef, Options);
    LRingRef := LRing;
    LRing.OnError := LSink.Log;
    LKid := SigningKid(LRingRef);
    LStore.Failing := True;
    Advance(10);
    TAssert.AssertEquals('the loaded key still signs', LKid, SigningKid(LRingRef));
    TAssert.AssertTrue('reported: ' + LSink.Lines, Pos('store down', LSink.Lines) > 0);
    TAssert.AssertTrue('names the class: ' + LSink.Lines, Pos('EInOutError', LSink.Lines) > 0);
    // Retried after ReloadSeconds, not on every request.
    LLoads := LStore.LoadCount;
    SigningKid(LRingRef);
    SigningKid(LRingRef);
    TAssert.AssertEquals('no retry within ReloadSeconds', LLoads, LStore.LoadCount);
    LStore.Failing := False;
    Advance(10);
    SigningKid(LRingRef);
    TAssert.AssertEquals('retried after ReloadSeconds', LLoads + 1, LStore.LoadCount);
  finally
    LSink.Free;
  end;
end;

procedure TJwtRotationTests.StoreDownAtStartup_Raises;
var
  LStore: TTestStore;
  LStoreRef: IJwtKeyStore;
begin
  LStore := TTestStore.Create;
  LStoreRef := LStore;
  LStore.Failing := True;
  TAssert.AssertEquals('EInOutError', CreateError(LStoreRef, Options, ''));
end;

procedure TJwtRotationTests.CorruptStore_Raises;
var
  LStore: IJwtKeyStore;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LStore.TryAdd('', StoredKey(1, 'k1', '', START));
  TAssert.AssertEquals('empty secret', 'EJwtKeyError', CreateError(LStore, Options, ''));
  LStore := TMemoryJwtKeyStore.Create;
  LStore.TryAdd('', StoredKey(0, 'k1', 's', START));
  TAssert.AssertEquals('generation 0', 'EJwtKeyError', CreateError(LStore, Options, ''));
  LStore := TMemoryJwtKeyStore.Create;
  LStore.TryAdd('', StoredKey(1, StringOfChar('k', JWT_MAX_KID_BYTES + 1), 's', START));
  TAssert.AssertEquals('kid too long', 'EJwtKeyError', CreateError(LStore, Options, ''));
end;

procedure TJwtRotationTests.UnknownKid_DoesNotReachTheStore;
var
  LStore: TTestStore;
  LStoreRef: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LLoads, I: Integer;
begin
  LStore := TTestStore.Create;
  LStoreRef := LStore;
  LRing := TRotatingJwtKeyRing.Create(LStoreRef, Options);
  LLoads := LStore.LoadCount;
  for I := 1 to 50 do
    TAssert.AssertEquals(Ord(jrBadSignature), Ord(DecodeWith(LRing,
      TJwt.SignHS256(Claims(GNow + 60), 'x', Format('%.16x', [I])))));
  TAssert.AssertEquals('no load for an unknown kid', LLoads, LStore.LoadCount);
end;

procedure TJwtRotationTests.Options_Validated;
var
  LStore: IJwtKeyStore;
  LOptions: TJwtRotationOptions;
begin
  LStore := TMemoryJwtKeyStore.Create;
  TAssert.AssertEquals('defaults', '', CreateError(LStore, TJwtRotationOptions.Default, ''));
  TAssert.AssertEquals('nil store', 'EArgumentException', CreateError(nil, Options, ''));
  LOptions := Options;
  LOptions.PropagationSeconds := LOptions.ReloadSeconds - 1;
  TAssert.AssertEquals('propagation < reload', 'EArgumentException',
    CreateError(LStore, LOptions, ''));
  LOptions := Options;
  LOptions.MaxTokenSeconds := 0;
  TAssert.AssertEquals('no max lifetime', 'EArgumentException', CreateError(LStore, LOptions, ''));
  LOptions := Options;
  LOptions.RotateEverySeconds := 0;
  TAssert.AssertEquals('no rotation', 'EArgumentException', CreateError(LStore, LOptions, ''));
  LOptions := Options;
  LOptions.ReloadSeconds := 0;
  LOptions.PropagationSeconds := 0;
  TAssert.AssertEquals('no reload', 'EArgumentException', CreateError(LStore, LOptions, ''));
  TAssert.AssertEquals('scope with "/"', 'EArgumentException', CreateError(LStore, Options, 'a/b'));
  TAssert.AssertEquals('scope too long', 'EArgumentException',
    CreateError(LStore, Options, StringOfChar('t', JWT_MAX_KID_BYTES - 16)));
  TAssert.AssertEquals('longest scope', '',
    CreateError(LStore, Options, StringOfChar('t', JWT_MAX_KID_BYTES - 17)));
end;

procedure TJwtRotationTests.Scope_PrefixesTheKid;
var
  LStore: IJwtKeyStore;
  LKid: string;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LKid := SigningKid(NewRing(LStore, Options, 'acme'));
  TAssert.AssertEquals('acme/', Copy(LKid, 1, 5));
  TAssert.AssertTrue(LKid, IsHex(Copy(LKid, 6, MaxInt)) and (Length(LKid) = 21));
  TAssert.AssertEquals('acme''s keys', 1, Length(LStore.Load('acme')));
  TAssert.AssertEquals('no key without scope', 0, Length(LStore.Load('')));
end;

procedure TJwtRotationTests.Sign_HonoursMaxTokenSeconds;
var
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LError: string;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LRing := TRotatingJwtKeyRing.Create(LStore, Options);
  TAssert.AssertEquals(Int64(600), LRing.MaxTokenSeconds);
  TJwtKeys.Sign(LRing, Claims(GNow + 600));
  LError := '';
  try
    TJwtKeys.Sign(LRing, Claims(GNow + 601));
  except
    on E: Exception do
      LError := E.ClassName;
  end;
  TAssert.AssertEquals('EArgumentException', LError);
end;

procedure TJwtRotationTests.LegacySecret_ForTokensWithoutKid;
var
  LStore: IJwtKeyStore;
  LOptions: TJwtRotationOptions;
  LRing: IJwtKeyRing;
begin
  LStore := TMemoryJwtKeyStore.Create;
  LRing := TRotatingJwtKeyRing.Create(LStore, Options);
  TAssert.AssertEquals('no legacy secret', Ord(jrBadSignature),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(GNow + 60), 'legacy'))));
  LOptions := Options;
  LOptions.LegacySecret := 'legacy';
  LRing := TRotatingJwtKeyRing.Create(LStore, LOptions);
  TAssert.AssertEquals('legacy secret', Ord(jrValid),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(GNow + 60), 'legacy'))));
end;

procedure TJwtRotationTests.MemoryStore_Rules;
var
  LStore: IJwtKeyStore;
begin
  LStore := TMemoryJwtKeyStore.Create;
  TAssert.AssertTrue(LStore.TryAdd('', StoredKey(1, 'k1', 's1', START)));
  TAssert.AssertFalse('same generation', LStore.TryAdd('', StoredKey(1, 'k2', 's2', START)));
  TAssert.AssertFalse('same kid', LStore.TryAdd('', StoredKey(2, 'k1', 's2', START)));
  TAssert.AssertTrue('another scope', LStore.TryAdd('acme', StoredKey(1, 'k1', 's3', START)));
  TAssert.AssertEquals(1, Length(LStore.Load('')));
  TAssert.AssertEquals('s3', LStore.Load('acme')[0].Secret);
  LStore.Delete('', 'k1');
  LStore.Delete('', 'k1'); // nothing to delete: no error
  TAssert.AssertEquals(0, Length(LStore.Load('')));
  TAssert.AssertEquals('the other scope stays', 1, Length(LStore.Load('acme')));
end;

{ TTenantJwtKeyRingTests }

function TenantClaims(const ATenant: string; AExp: Int64): string;
begin
  Result := Format('{"sub":"ana","tenant_id":"%s","exp":%d}', [ATenant, AExp]);
end;

function NewTenantRing(const ACatalog: ITenantCatalog; const AStore: IJwtKeyStore;
  const ALegacy: string = ''): IJwtKeyRing;
var
  LOptions: TJwtRotationOptions;
begin
  LOptions := Options;
  LOptions.LegacySecret := ALegacy;
  Result := TTenantJwtKeyRing.Create(ACatalog, AStore, LOptions);
end;

function TwoTenants(out ACatalog: TTestCatalog): ITenantCatalog;
begin
  ACatalog := TTestCatalog.Create;
  Result := ACatalog;
  ACatalog.Add('acme');
  ACatalog.Add('globex');
end;

function SignError(const ARing: IJwtKeyRing; const AClaims: string): string;
begin
  Result := '';
  try
    TJwtKeys.Sign(ARing, AClaims);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

procedure TTenantJwtKeyRingTests.Setup;
begin
  GNow := START;
  GTickMs := 5000000;
  TClock.SetClock(TRotationClock.Create);
  TTicker.SetTicker(TRotationTicker.Create);
end;

procedure TTenantJwtKeyRingTests.TearDown;
begin
  TClock.Reset;
  TTicker.Reset;
end;

procedure TTenantJwtKeyRingTests.EachTenant_ItsOwnKey;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LAcme, LGlobex: string;
  LClaims: TJsonValue;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LRing := NewTenantRing(LCatalogRef, LStore);
  TAssert.AssertEquals('a key per tenant at startup', 1, Length(LStore.Load('acme')));
  TAssert.AssertEquals(1, Length(LStore.Load('globex')));
  TAssert.AssertEquals('none without a tenant', 0, Length(LStore.Load('')));
  TAssert.AssertEquals('tenant_id', LRing.ScopeClaim);
  LAcme := TJwtKeys.Sign(LRing, TenantClaims('acme', GNow + 60));
  LGlobex := TJwtKeys.Sign(LRing, TenantClaims('globex', GNow + 60));
  TAssert.AssertEquals('acme/', Copy(KidOf(LAcme), 1, 5));
  TAssert.AssertEquals('globex/', Copy(KidOf(LGlobex), 1, 7));
  TAssert.AssertEquals('acme''s token', Ord(jrValid),
    Ord(TJwtKeys.Decode(LRing, LAcme, LClaims)));
  try
    TAssert.AssertEquals('acme', LClaims.Find('tenant_id').AsString);
  finally
    LClaims.Free;
  end;
  TAssert.AssertEquals('globex''s token', Ord(jrValid), Ord(DecodeWith(LRing, LGlobex)));
end;

procedure TTenantJwtKeyRingTests.TenantsKey_RefusedForAnotherTenantsClaim;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LKey: TJwtKey;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LRing := NewTenantRing(LCatalogRef, LStore);
  LKey := LStore.Load('acme')[0];
  // acme's key (leaked, say) signing a token that claims globex.
  TAssert.AssertEquals('another tenant''s claim', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('globex', GNow + 60), LKey.Secret, LKey.Kid))));
  TAssert.AssertEquals('no tenant claim', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(Claims(GNow + 60), LKey.Secret, LKey.Kid))));
  TAssert.AssertEquals('a non-string claim', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(Format('{"tenant_id":7,"exp":%d}', [GNow + 60]), LKey.Secret, LKey.Kid))));
  // And globex's kid with acme's secret: the signature.
  TAssert.AssertEquals('another tenant''s kid', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('globex', GNow + 60), LKey.Secret,
      LStore.Load('globex')[0].Kid))));
  TAssert.AssertEquals('its own claim', Ord(jrValid), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('acme', GNow + 60), LKey.Secret, LKey.Kid))));
end;

procedure TTenantJwtKeyRingTests.UnknownTenantKid_NoQuery;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: TTestStore;
  LStoreRef: IJwtKeyStore;
  LTenantRing: TTenantJwtKeyRing;
  LRing: IJwtKeyRing;
  LLoads, LFinds, LAlls, I: Integer;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TTestStore.Create;
  LStoreRef := LStore;
  LTenantRing := TTenantJwtKeyRing.Create(LCatalogRef, LStoreRef, Options);
  LRing := LTenantRing;
  LLoads := LStore.LoadCount;
  LFinds := LCatalog.FindCount;
  LAlls := LCatalog.AllCount;
  for I := 1 to 50 do
    TAssert.AssertEquals(Ord(jrBadSignature), Ord(DecodeWith(LRing,
      TJwt.SignHS256(TenantClaims(Format('t%d', [I]), GNow + 60), 'x',
        Format('t%d/%.16x', [I, I])))));
  TAssert.AssertEquals('no store load', LLoads, LStore.LoadCount);
  TAssert.AssertEquals('no catalog find', LFinds, LCatalog.FindCount);
  TAssert.AssertEquals('no catalog read', LAlls, LCatalog.AllCount);
  TAssert.AssertEquals('no ring for them', 2, LTenantRing.TenantCount);
end;

procedure TTenantJwtKeyRingTests.Sign_NeedsAKnownTenant;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LRing := NewTenantRing(LCatalogRef, LStore);
  TAssert.AssertEquals('no tenant', 'EJwtKeyError', SignError(LRing, Claims(GNow + 60)));
  TAssert.AssertEquals('not in the catalog', 'EJwtKeyError',
    SignError(LRing, TenantClaims('wayne', GNow + 60)));
  TAssert.AssertEquals('not a tenant id', 'EJwtKeyError',
    SignError(LRing, TenantClaims('Acme', GNow + 60)));
  TAssert.AssertEquals('no key stored for them', 0, Length(LStore.Load('wayne')));
  TAssert.AssertEquals('past MaxTokenSeconds', 'EArgumentException',
    SignError(LRing, TenantClaims('acme', GNow + 601)));
end;

procedure TTenantJwtKeyRingTests.TenantAddedLater;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LA, LB: IJwtKeyRing;
  LToken: string;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LA := NewTenantRing(LCatalogRef, LStore);
  LB := NewTenantRing(LCatalogRef, LStore);
  LCatalog.Add('initech');
  // A signs for the new tenant at once (its login found it in the catalog).
  LToken := TJwtKeys.Sign(LA, TenantClaims('initech', GNow + 60));
  TAssert.AssertEquals('initech/', Copy(KidOf(LToken), 1, 8));
  // B doesn't know the tenant until its next catalog read...
  TAssert.AssertEquals('B, before its catalog read', Ord(jrBadSignature),
    Ord(DecodeWith(LB, LToken)));
  // ...ReloadSeconds later, on a request.
  Advance(10);
  TAssert.AssertEquals('B, after', Ord(jrValid), Ord(DecodeWith(LB, LToken)));
  TAssert.AssertEquals('one key for initech', 1, Length(LStore.Load('initech')));
end;

procedure TTenantJwtKeyRingTests.LegacyAndMalformedKids;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LKey: TJwtKey;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LRing := NewTenantRing(LCatalogRef, LStore, 'legacy');
  TAssert.AssertEquals('no kid: the legacy secret', Ord(jrValid),
    Ord(DecodeWith(LRing, TJwt.SignHS256(TenantClaims('acme', GNow + 60), 'legacy'))));
  LKey := LStore.Load('acme')[0];
  TAssert.AssertEquals('a kid without tenant', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('acme', GNow + 60), LKey.Secret,
      Copy(LKey.Kid, 6, MaxInt)))));
  TAssert.AssertEquals('an empty tenant', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('acme', GNow + 60), LKey.Secret,
      Copy(LKey.Kid, 5, MaxInt)))));
  TAssert.AssertEquals('a tenant with "/" in front', Ord(jrBadSignature), Ord(DecodeWith(LRing,
    TJwt.SignHS256(TenantClaims('acme', GNow + 60), LKey.Secret, 'x/' + LKey.Kid))));
end;

procedure TTenantJwtKeyRingTests.Rotation_PerTenant;
var
  LCatalog: TTestCatalog;
  LCatalogRef: ITenantCatalog;
  LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LOld, LNew: string;
begin
  LCatalogRef := TwoTenants(LCatalog);
  LStore := TMemoryJwtKeyStore.Create;
  LRing := NewTenantRing(LCatalogRef, LStore);
  Advance(1000);
  // acme's ring rotates on this request; the old key signs until the new
  // one is active.
  LOld := TJwtKeys.Sign(LRing, TenantClaims('acme', GNow + 600));
  Advance(60);
  LNew := TJwtKeys.Sign(LRing, TenantClaims('acme', GNow + 60));
  TAssert.AssertTrue('a new acme key', KidOf(LNew) <> KidOf(LOld));
  TAssert.AssertEquals('acme''s old token', Ord(jrValid), Ord(DecodeWith(LRing, LOld)));
  TAssert.AssertEquals('acme rotated', 2, Length(LStore.Load('acme')));
  // globex's ring rotates on its own requests, not on acme's.
  TAssert.AssertEquals('globex untouched', 1, Length(LStore.Load('globex')));
end;

{ TSealedSecretTests }

const
  // Master keys: 32 bytes 00..1f (standard Base64, as openssl rand -base64
  // prints) and 32 bytes of 0xaa (Base64url, without padding).
  MASTER_1 = 'm1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=';
  MASTER_2 = 'm2:qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo';
  // Sealed by Python's cryptography (OpenSSL) with MASTER_1's key, nonce
  // 100..111, for the context below.
  OPENSSL_SEALED = 'aesgcm:v1:m1:ZGVmZ2hpamtsbW5v:IXWqAwuGJrNNBzyavxFHiyOuc2-7ya7UMDpMTRNWJq0b2BnR';
  OPENSSL_CONTEXT = 'jwt-key|acme|acme/0123456789abcdef|3';

function CipherError(const AText: string): string;
var
  LCipher: IJwtSecretCipher;
begin
  Result := '';
  try
    LCipher := TAesGcmSecretCipher.Create(AText);
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function OpenError(const ACipher: IJwtSecretCipher; const AValue, AContext: string): string;
var
  LSecret: string;
begin
  Result := '';
  try
    if not ACipher.Open(AValue, AContext, LSecret) then
      Result := 'plain';
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function Sealed(const AInner: IJwtKeyStore; const ACipher: IJwtSecretCipher;
  ARequire: Boolean = False): IJwtKeyStore;
begin
  Result := TSealedJwtKeyStore.Create(AInner, ACipher, ARequire);
end;

function Cipher(const AText: string): IJwtSecretCipher;
begin
  Result := TAesGcmSecretCipher.Create(AText);
end;

function OpenText(const ACipher: IJwtSecretCipher; const AValue, AContext: string): string;
begin
  if not ACipher.Open(AValue, AContext, Result) then
    Result := '<plain>';
end;

procedure TSealedSecretTests.Setup;
begin
  GNow := START;
  GTickMs := 5000000;
  TClock.SetClock(TRotationClock.Create);
  TTicker.SetTicker(TRotationTicker.Create);
end;

procedure TSealedSecretTests.TearDown;
begin
  TClock.Reset;
  TTicker.Reset;
end;

procedure TSealedSecretTests.MasterKeys_Parsed;
var
  LCipher: TAesGcmSecretCipher;
  LRef: IJwtSecretCipher;
begin
  LCipher := TAesGcmSecretCipher.Create(' ' + MASTER_2 + ' , ' + MASTER_1 + ' ');
  LRef := LCipher;
  TAssert.AssertEquals('the first one seals', 'm2', LCipher.SealingId);
  TAssert.AssertEquals('', CipherError(MASTER_1));
  TAssert.AssertEquals('Base64url, no padding', '', CipherError(MASTER_2));
end;

procedure TSealedSecretTests.MasterKeys_Invalid;

  procedure Refused(const AName, AText: string);
  var
    LError: string;
  begin
    LError := CipherError(AText);
    TAssert.AssertTrue(AName + ': ' + LError, Copy(LError, 1, 12) = 'EJwtKeyError');
    // Never the key itself in the message.
    TAssert.AssertTrue(AName + ' shows no key: ' + LError,
      Pos('AAECAwQFBgcICQoLDA0ODx', LError) + Pos('qqqqqqqq', LError) = 0);
  end;

begin
  Refused('empty', '');
  Refused('no id', 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=');
  Refused('empty id', ':AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=');
  Refused('invalid id', 'm/1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=');
  Refused('16 bytes', 'm1:AAECAwQFBgcICQoLDA0ODw==');
  Refused('33 bytes', 'm1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8g');
  Refused('not Base64', 'm1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh*=');
  Refused('repeated id', MASTER_1 + ',m1:qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo');
  Refused('trailing comma', MASTER_1 + ',');
end;

procedure TSealedSecretTests.Seal_ThenOpen;
var
  LCipher: IJwtSecretCipher;
  LSealed, LAgain: string;
begin
  LCipher := Cipher(MASTER_1);
  LSealed := LCipher.Seal('the-secret-ção', 'jwt-key||k1|1');
  TAssert.AssertEquals('aesgcm:v1:m1:', Copy(LSealed, 1, 13));
  TAssert.AssertTrue('no secret in the sealed value', Pos('the-secret', LSealed) = 0);
  TAssert.AssertEquals('the-secret-ção', OpenText(LCipher, LSealed, 'jwt-key||k1|1'));
  // A new nonce every time: the same secret never seals the same twice.
  LAgain := LCipher.Seal('the-secret-ção', 'jwt-key||k1|1');
  TAssert.AssertTrue(LSealed <> LAgain);
  // A plain value is not an error: it was stored before sealing.
  TAssert.AssertEquals('plain', OpenError(LCipher, 'Zm9vYmFy', 'jwt-key||k1|1'));
end;

procedure TSealedSecretTests.Open_OpenSslSealedValue;
begin
  TAssert.AssertEquals('interop-secret-value',
    OpenText(Cipher(MASTER_1), OPENSSL_SEALED, OPENSSL_CONTEXT));
end;

procedure TSealedSecretTests.Open_RefusesAnotherContextOrKey;
var
  LError: string;
begin
  LError := OpenError(Cipher(MASTER_1), OPENSSL_SEALED, 'jwt-key|globex|acme/0123456789abcdef|3');
  TAssert.AssertTrue('another place: ' + LError, Copy(LError, 1, 12) = 'EJwtKeyError');
  TAssert.AssertTrue('names the master id', Pos('"m1"', LError) > 0);
  TAssert.AssertTrue('no secret', Pos('interop', LError) = 0);
  TAssert.AssertTrue('another key under the id',
    Copy(OpenError(Cipher('m1:qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqo'), OPENSSL_SEALED,
      OPENSSL_CONTEXT), 1, 12) = 'EJwtKeyError');
  TAssert.AssertTrue('an unknown master id',
    Pos('doesn''t have', OpenError(Cipher(MASTER_2), OPENSSL_SEALED, OPENSSL_CONTEXT)) > 0);
  TAssert.AssertTrue('an unknown version', Copy(OpenError(Cipher(MASTER_1),
    'aesgcm:v9:m1:x:y', OPENSSL_CONTEXT), 1, 12) = 'EJwtKeyError');
  TAssert.AssertTrue('a changed value', Copy(OpenError(Cipher(MASTER_1),
    Copy(OPENSSL_SEALED, 1, Length(OPENSSL_SEALED) - 1) + 'S', OPENSSL_CONTEXT), 1, 12) = 'EJwtKeyError');
  TAssert.AssertTrue('a cut value', Copy(OpenError(Cipher(MASTER_1),
    'aesgcm:v1:m1:ZGVmZ2hpamtsbW5v:IXWq', OPENSSL_CONTEXT), 1, 12) = 'EJwtKeyError');
  TAssert.AssertTrue('no parts', Copy(OpenError(Cipher(MASTER_1), 'aesgcm:v1:m1',
    OPENSSL_CONTEXT), 1, 12) = 'EJwtKeyError');
end;

procedure TSealedSecretTests.MasterKeyRotation;
var
  LOld, LNew: IJwtSecretCipher;
  LSealedOld: string;
begin
  LOld := Cipher(MASTER_1);
  LSealedOld := LOld.Seal('old', 'c');
  // The new master key first, the old one after it: old values still open,
  // new ones are sealed with m2.
  LNew := Cipher(MASTER_2 + ',' + MASTER_1);
  TAssert.AssertEquals('old', OpenText(LNew, LSealedOld, 'c'));
  TAssert.AssertEquals('aesgcm:v1:m2:', Copy(LNew.Seal('new', 'c'), 1, 13));
  // Once m1 is dropped, what it sealed no longer opens.
  TAssert.AssertTrue(Pos('doesn''t have', OpenError(Cipher(MASTER_2), LSealedOld, 'c')) > 0);
end;

procedure TSealedSecretTests.Store_SealsAndOpens;
var
  LInner, LStore: IJwtKeyStore;
  LKey: TJwtKey;
begin
  LInner := TMemoryJwtKeyStore.Create;
  LStore := Sealed(LInner, Cipher(MASTER_1));
  TAssert.AssertTrue(LStore.TryAdd('acme', StoredKey(1, 'acme/0123456789abcdef', 's3cret', START)));
  LKey := LInner.Load('acme')[0];
  TAssert.AssertEquals('sealed in the store', 'aesgcm:v1:m1:', Copy(LKey.Secret, 1, 13));
  TAssert.AssertEquals('plain to the ring', 's3cret', LStore.Load('acme')[0].Secret);
  TAssert.AssertEquals('jwt-key|acme|acme/0123456789abcdef|1',
    TSealedJwtKeyStore.Context('acme', LKey));
  LStore.Delete('acme', 'acme/0123456789abcdef');
  TAssert.AssertEquals('deleted', 0, Length(LInner.Load('acme')));
end;

function LoadError(const AStore: IJwtKeyStore; const AScope: string): string;
begin
  Result := '';
  try
    AStore.Load(AScope);
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

procedure TSealedSecretTests.Store_PlainRows;
var
  LInner: IJwtKeyStore;
begin
  LInner := TMemoryJwtKeyStore.Create;
  LInner.TryAdd('', StoredKey(1, 'k1', 'plain-from-before', START));
  TAssert.AssertEquals('accepted by default', 'plain-from-before',
    Sealed(LInner, Cipher(MASTER_1)).Load('')[0].Secret);
  TAssert.AssertTrue('refused when sealing is required',
    Pos('is not sealed', LoadError(Sealed(LInner, Cipher(MASTER_1), True), '')) > 0);
end;

procedure TSealedSecretTests.Store_SecretMovedToAnotherRow;
var
  LInner, LStore: IJwtKeyStore;
  LAcme, LGlobex: TJwtKey;
begin
  LInner := TMemoryJwtKeyStore.Create;
  LStore := Sealed(LInner, Cipher(MASTER_1));
  LStore.TryAdd('acme', StoredKey(1, 'acme/0123456789abcdef', 'acme-secret', START));
  // Someone with write access to the table copies acme's sealed secret into
  // a row of globex's: it doesn't open there.
  LAcme := LInner.Load('acme')[0];
  LGlobex := StoredKey(1, 'globex/0123456789abcdef', LAcme.Secret, START);
  LInner.TryAdd('globex', LGlobex);
  TAssert.AssertTrue(Pos('doesn''t open', LoadError(LStore, 'globex')) > 0);
end;

procedure TSealedSecretTests.Ring_OnASealedStore;
var
  LInner, LStore: IJwtKeyStore;
  LRing: IJwtKeyRing;
  LToken: string;
begin
  LInner := TMemoryJwtKeyStore.Create;
  LStore := Sealed(LInner, Cipher(MASTER_1));
  LRing := NewRing(LStore, Options);
  LToken := TJwtKeys.Sign(LRing, Claims(GNow + 60));
  TAssert.AssertEquals(Ord(jrValid), Ord(DecodeWith(LRing, LToken)));
  TAssert.AssertEquals('the store holds it sealed', 'aesgcm:v1:m1:',
    Copy(LInner.Load('')[0].Secret, 1, 13));
  // Another instance with the same master key verifies it.
  TAssert.AssertEquals(Ord(jrValid), Ord(DecodeWith(NewRing(
    Sealed(LInner, Cipher(MASTER_1)), Options), LToken)));
end;

