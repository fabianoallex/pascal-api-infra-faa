procedure TDbJwtKeyStoreTests.TryAdd_OtherErrors_Raise;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LMock.AddConstraintViolation('JWT_KEY.INSERT', cvNotNull);
  TAssert.AssertEquals('EConstraintViolationException', AddError(LMock));
  LMock.AddFailure('JWT_KEY.INSERT', EInOutError, 'connection lost');
  TAssert.AssertEquals('EInOutError', AddError(LMock));
end;

procedure TDbJwtKeyStoreTests.Delete_PassesScopeAndKid;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
begin
  LMock := TMockDBFactory.Create;
