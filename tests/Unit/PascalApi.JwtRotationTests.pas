  DbStore(LFactory, 'L', 'A', 'D').Delete('acme', 'k1');
  TAssert.AssertEquals('acme', LMock.LastExecution('D').AsString('TENANT_ID'));
  TAssert.AssertEquals('k1', LMock.LastExecution('D').AsString('KID'));
end;

procedure TDbJwtKeyStoreTests.Ring_OnTheDbStore;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LRing: IJwtKeyRing;
  LKey: TJwtKey;
begin
  GNow := START + 1000;
  TClock.SetClock(TRotationClock.Create);
  try
    LMock := TMockDBFactory.Create;
    LFactory := LMock;
    LMock.AddResult('JWT_KEY.BY_TENANT', KeyRows);
    LRing := NewRing(DbStore(LFactory), Options);
    TAssert.AssertTrue(LRing.SigningKey(nil, LKey));
    TAssert.AssertEquals('the newest active key signs', 'k2', LKey.Kid);
    TAssert.AssertTrue(LRing.FindKey('k1', LKey));
    TAssert.AssertEquals('k1 until k2 + MaxTokenSeconds', Int64(START + 1600), LKey.NotAfter);
    TAssert.AssertEquals('no rotation yet', 0, LMock.ExecutionCount('JWT_KEY.INSERT'));
  finally
    TClock.Reset;
  end;
end;

