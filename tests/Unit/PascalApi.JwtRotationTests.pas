  Result := TMockQueryResult.MultiRows(['KID', 'SECRET', 'GENERATION', 'CREATED_AT', 'ACTIVE_FROM'],
    [TArray<Variant>.Create('k2', 'secret-2', 2, Int64(START + 900), Int64(START + 1000)),
     TArray<Variant>.Create('k1', 'secret-1', 1, Int64(START), Int64(START))]);
