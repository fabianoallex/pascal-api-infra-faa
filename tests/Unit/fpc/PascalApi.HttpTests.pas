  TAssert.AssertEquals(400, R.Status);
  TAssert.AssertEquals('Invalid request body: $.age: expected a number, found JSON string', R.Message);
end;

procedure TErrorMappingTests.JsonMapperErrorWithoutPath_Is500;
var
  R: TErrorResponse;
