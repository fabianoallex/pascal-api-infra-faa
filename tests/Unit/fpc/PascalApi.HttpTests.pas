  TAssert.AssertTrue(R.LogLine <> '');
end;

procedure TErrorMappingTests.ConstraintUniqueAndForeignKey_Are409_NotLogged;
var
  R: TErrorResponse;
begin
  R := Map(EConstraintViolationException.Create(cvUnique, nil));
  TAssert.AssertEquals(409, R.Status);
  TAssert.AssertEquals('A record with these values already exists.', R.Message);
  TAssert.AssertEquals('', R.LogLine);
  R := Map(EConstraintViolationException.Create(cvForeignKey, nil));
  TAssert.AssertEquals(409, R.Status);
  TAssert.AssertEquals('', R.LogLine);
end;

procedure TErrorMappingTests.ConstraintNotNullAndCheck_Are422_Logged;
var
  R: TErrorResponse;
  LDriver: Exception;
begin
  LDriver := Exception.Create('NAME cannot be NULL');
  try
    R := Map(EConstraintViolationException.Create(cvNotNull, LDriver));
  finally
    LDriver.Free;
  end;
  TAssert.AssertEquals(422, R.Status);
  TAssert.AssertEquals('A required field is missing.', R.Message);
  TAssert.AssertTrue('method, path, status', Pos('POST /cities -> 422: EConstraintViolationException',
    R.LogLine) = 1);
  TAssert.AssertTrue('driver detail', Pos('(Exception: NAME cannot be NULL)', R.LogLine) > 0);
  TAssert.AssertEquals(422, Map(EConstraintViolationException.Create(cvCheck, nil)).Status);
end;

procedure TErrorMappingTests.LockConflict_Is409_Logged;
var
  R: TErrorResponse;
begin
  R := Map(ELockConflictException.Create(nil));
  TAssert.AssertEquals(409, R.Status);
  TAssert.AssertEquals('The record is locked or was changed by another operation. Try again.',
    R.Message);
  TAssert.AssertTrue(R.LogLine <> '');
end;

procedure TErrorMappingTests.DatabaseUnavailable_Is503_DetailOnlyInLog;
var
  R: TErrorResponse;
  LDriver: Exception;
begin
  LDriver := Exception.Create('connection refused 10.0.0.5:3050');
  try
    R := Map(EDatabaseUnavailableException.Create(LDriver));
  finally
    LDriver.Free;
  end;
  TAssert.AssertEquals(503, R.Status);
  TAssert.AssertEquals('The database is unavailable. Try again shortly.', R.Message);
  TAssert.AssertTrue('detail in the log', Pos('10.0.0.5', R.LogLine) > 0);
  TAssert.AssertTrue('never in the message', Pos('10.0.0.5', R.Message) = 0);
end;

procedure TErrorMappingTests.Other_Is500_Logged;
var
  R: TErrorResponse;
begin
  R := Map(EAccessViolation.Create('boom'));
  TAssert.AssertEquals(500, R.Status);
  TAssert.AssertEquals('boom', R.Message);
  TAssert.AssertEquals('POST /cities -> 500: EAccessViolation: boom', R.LogLine);
end;

procedure TErrorMappingTests.Messages_CanBeReplaced;
begin
  TApiMessages.Current := TApiMessages.Portuguese;
  TAssert.AssertEquals('Já existe um registro com estes dados.',
    Map(EConstraintViolationException.Create(cvUnique, nil)).Message);
  TAssert.AssertEquals('Recurso não encontrado.', Map(ENotFoundException.Create).Message);
end;

procedure TErrorMappingTests.ErrorJson_EscapesAndKeepsNonAscii;
var
  LParsed: TJsonValue;
begin
  TAssert.AssertEquals('{"error":"não encontrado"}', ErrorJson('não encontrado'));
  LParsed := ParseJson(ErrorJson('say "hi"\ now'#10));
  try
    TAssert.AssertEquals('say "hi"\ now'#10, LParsed.Find('error').AsString);
  finally
    LParsed.Free;
  end;
end;

