const
  COUNT_SQL = 'SELECT COUNT(*) AS TOTAL FROM T WHERE ${TENANT} AND N LIKE :S';
  COUNT_RUN = 'SELECT COUNT(*) AS TOTAL FROM T WHERE TENANT_ID = :TENANT_ID AND N LIKE :S';
  PAGE_SQL = 'SELECT ID FROM T WHERE ${TENANT} AND N LIKE :S ORDER BY ${ORDER} ${PAGE}';
  PAGE_RUN = 'SELECT ID FROM T WHERE TENANT_ID = :TENANT_ID AND N LIKE :S ' +
    'ORDER BY ID DESC LIMIT 2 OFFSET 2';

function ReadId(const AResult: IQueryResult): string;
begin
  Result := AResult.Strings['ID'];
end;

function ReadIdOrFail(const AResult: IQueryResult): string;
begin
  raise EConvertError.Create('reader failed');
end;

procedure TPagedQueryTests.SetUp;
begin
  FMock := TMockDBFactory.Create;
  FMockRef := FMock;
  FScope.Factory := FMockRef;
  FScope.Discriminator := 'initech';
end;

procedure TPagedQueryTests.TearDown;
begin
  FScope.Factory := nil;
  FMockRef := nil;
end;

procedure TPagedQueryTests.Run_CountsAndPages_BindsBoth;
var
  LPage: TPage<string>;
begin
  FMock.AddResult(COUNT_RUN, TMockQueryResult.SingleRow(['TOTAL'], [5]));
  FMock.AddResult(PAGE_RUN, TMockQueryResult.MultiRows(['ID'],
    [TArray<Variant>.Create('c'), TArray<Variant>.Create('d')]));
  LPage := TTenantPagedQuery.Run<string>(FScope, TSQLResult.From(COUNT_SQL),
    TSQLResult.From(PAGE_SQL), 'ID DESC', TPageRequest.Create(2, 2),
    TQueryArgs.New.Strings('S', '%x%'), ReadId);
  TAssert.AssertEquals(Int64(5), LPage.Meta.Total);
  TAssert.AssertEquals(3, LPage.Meta.TotalPages);
  TAssert.AssertEquals(2, Length(LPage.Items));
  TAssert.AssertEquals('c', LPage.Items[0]);
  TAssert.AssertEquals('d', LPage.Items[1]);
  TAssert.AssertEquals('count: the argument', '%x%', FMock.LastExecution(COUNT_RUN).AsString('S'));
  TAssert.AssertEquals('count: the tenant', 'initech',
    FMock.LastExecution(COUNT_RUN).AsString('TENANT_ID'));
  TAssert.AssertEquals('page: the argument again', '%x%',
    FMock.LastExecution(PAGE_RUN).AsString('S'));
  TAssert.AssertEquals('page: the tenant', 'initech',
    FMock.LastExecution(PAGE_RUN).AsString('TENANT_ID'));
end;

procedure TPagedQueryTests.Run_Empty;
var
  LPage: TPage<string>;
begin
  FMock.AddResult(COUNT_RUN, TMockQueryResult.SingleRow(['TOTAL'], [0]));
  FMock.AddResult(PAGE_RUN, TMockQueryResult.Empty);
  LPage := TTenantPagedQuery.Run<string>(FScope, TSQLResult.From(COUNT_SQL),
    TSQLResult.From(PAGE_SQL), 'ID DESC', TPageRequest.Create(2, 2),
    TQueryArgs.New.Strings('S', '%'), ReadId);
  TAssert.AssertEquals(Int64(0), LPage.Meta.Total);
  TAssert.AssertEquals(0, Length(LPage.Items));
end;

procedure TPagedQueryTests.Run_OnAFactory_WithoutTenant;
const
  PLAIN_COUNT = 'SELECT COUNT(*) AS TOTAL FROM T WHERE N LIKE :S';
  PLAIN_PAGE = 'SELECT ID FROM T WHERE N LIKE :S ORDER BY ${ORDER} ${PAGE}';
  PLAIN_PAGE_RUN = 'SELECT ID FROM T WHERE N LIKE :S ORDER BY ID LIMIT 10 OFFSET 0';
var
  LPage: TPage<string>;
begin
  FMock.AddResult(PLAIN_COUNT, TMockQueryResult.SingleRow(['TOTAL'], [1]));
  FMock.AddResult(PLAIN_PAGE_RUN, TMockQueryResult.MultiRows(['ID'], [TArray<Variant>.Create('a')]));
  LPage := TPagedQuery.Run<string>(FMockRef, TSQLResult.From(PLAIN_COUNT),
    TSQLResult.From(PLAIN_PAGE), 'ID', TPageRequest.Create(1, 10),
    TQueryArgs.New.Strings('S', 'a%'), ReadId);
  TAssert.AssertEquals(1, Length(LPage.Items));
  TAssert.AssertEquals('a', LPage.Items[0]);
  TAssert.AssertEquals('a%', FMock.LastExecution(PLAIN_PAGE_RUN).AsString('S'));
  TAssert.AssertFalse('no tenant parameter', FMock.LastExecution(PLAIN_PAGE_RUN).HasParam('TENANT_ID'));
end;

procedure TPagedQueryTests.Run_ReaderRaises_Propagates;
var
  LMessage: string;
begin
  FMock.AddResult(COUNT_RUN, TMockQueryResult.SingleRow(['TOTAL'], [1]));
  FMock.AddResult(PAGE_RUN, TMockQueryResult.MultiRows(['ID'], [TArray<Variant>.Create('c')]));
  LMessage := '';
  try
    TTenantPagedQuery.Run<string>(FScope, TSQLResult.From(COUNT_SQL),
      TSQLResult.From(PAGE_SQL), 'ID DESC', TPageRequest.Create(2, 2),
      TQueryArgs.New.Strings('S', '%'), ReadIdOrFail);
  except
    on E: EConvertError do
      LMessage := E.Message;
  end;
  TAssert.AssertEquals('reader failed', LMessage);
end;

procedure TPagedQueryTests.Args_EveryKindIsBound;
const
  SQL = 'DELETE FROM T WHERE A = :A AND B = :B AND C = :C AND D = :D AND E = :E AND F = :F';
var
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  LTx := FScope.Factory.GetPool.AcquireQuery(LQuery);
  LQuery.Sql := SQL;
  TQueryArgs.New.Strings('A', 'x').Integers('B', 7).Int64s('C', 9000000000)
    .Booleans('D', True).Doubles('E', 1.5).Flags('F', True).ApplyTo(LQuery);
  LQuery.ExecSql;
  TAssert.AssertEquals('x', FMock.LastExecution(SQL).AsString('A'));
  TAssert.AssertEquals(7, FMock.LastExecution(SQL).AsInteger('B'));
  TAssert.AssertEquals(Int64(9000000000), FMock.LastExecution(SQL).AsInt64('C'));
  TAssert.AssertTrue(FMock.LastExecution(SQL).AsBoolean('D'));
  TAssert.AssertEquals('A flag is bound as the Integer 1 (PostgreSQL refuses a Boolean for an integer column)',
    1, FMock.LastExecution(SQL).AsInteger('F'));
end;

procedure TPagedQueryTests.Args_SettersReturnACopy;
var
  L1, L2: TQueryArgs;
begin
  L1 := TQueryArgs.New.Strings('A', 'x');
  L2 := L1.Integers('B', 1);
  TAssert.AssertEquals(1, L1.Count);
  TAssert.AssertEquals(2, L2.Count);
  TAssert.AssertEquals(0, TQueryArgs.New.Count);
end;

initialization
  RegisterTest(TPagedQueryTests);

end.
