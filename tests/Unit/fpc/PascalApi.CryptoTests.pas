  TJwtClock = class(TInterfacedObject, IClock)
  private
    FTime: TDateTime;
  public
    constructor Create(AUnix: Int64);
    function Now: TDateTime;
    function Date: TDateTime;
  end;

  TCryptoTests = class(TTestCase)
  published
    procedure Sha256_Fips180Examples;
    procedure Sha256_AroundBlockBoundary;
    procedure Sha256_OneMillionA;
    procedure Sha256_NonAsciiHashesUtf8;
    procedure Hmac_Rfc4231;
    procedure Base64Url_Rfc4648;
    procedure Base64Url_UrlAlphabet;
    procedure Base64Url_DecodeRoundTrip;
    procedure Base64Url_DecodeRejectsInvalid;
    procedure SameBytes;
  end;

