implementation

const
  NOW_UNIX = 1700000000;
  JWT_IO_CLAIMS = '{"sub":"1234567890","name":"John Doe","iat":1516239022}';
  JWT_IO_SECRET = 'your-256-bit-secret';
  // Python: hmac over base64url('{"alg":"HS256","typ":"JWT","kid":"k1"}') + '.' + claims.
  KID_TOKEN = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImsxIn0.' +
    'eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.' +
    '7_waepInKUYpi5mFJ12NwiMxGQZQIGsVVDL5BsolGCA';
  SECRET_1 = 'first-secret-value';
  SECRET_2 = 'second-secret-value';
  LEGACY = 'legacy-secret-value';

function Claims(AExp: Int64): string;
begin
  Result := Format('{"sub":"ana","exp":%d}', [AExp]);
end;

function KidOf(const AToken: string): string;
begin
  if TJwt.ReadKid(AToken, Result) <> jrValid then
    Result := '<malformed>';
end;

function DecodeWith(const ARing: IJwtKeyRing; const AToken: string): TJwtResult;
var
  LClaims: TJsonValue;
begin
  Result := TJwtKeys.Decode(ARing, AToken, LClaims);
  if (Result = jrValid) <> Assigned(LClaims) then
    Result := jrMalformed; // claims must come exactly with jrValid
  LClaims.Free;
end;

// The exception a call raised, as 'Class: message', or ''.
function ParseError(const AText: string): string;
begin
  Result := '';
  try
    TStaticJwtKeyRing.Parse(AText, '');
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function CreateError(const AKeys: array of TJwtKey; const ALegacy: string): string;
begin
  Result := '';
  try
    TStaticJwtKeyRing.Create(AKeys, ALegacy).Free;
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function SignError(const ARing: IJwtKeyRing; const AClaims: string): string;
begin
  Result := '';
  try
    TJwtKeys.Sign(ARing, AClaims);
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function SignKidError(const AKid: string): string;
begin
  Result := '';
  try
    TJwt.SignHS256(JWT_IO_CLAIMS, JWT_IO_SECRET, AKid);
  except
    on E: Exception do
      Result := E.ClassName + ': ' + E.Message;
  end;
end;

function B64(const S: string): string;
begin
  Result := PaBase64UrlEncode(PaStringToUtf8Bytes(S));
end;

// 64 x 'é': 64 characters, 128 bytes in UTF-8. A typed constant: FPC
// warns on a non-ASCII literal inside an expression (an implicit
// UnicodeString conversion), not on a typed constant.
function TwoByteKid: string;
const
  PAIR: string = 'éé';
var
  I: Integer;
begin
  Result := '';
  for I := 1 to 32 do
    Result := Result + PAIR;
end;

function StartsWith(const APrefix, AText: string): Boolean;
begin
  Result := Copy(AText, 1, Length(APrefix)) = APrefix;
end;

function OneRing: IJwtKeyRing;
begin
  Result := TStaticJwtKeyRing.Parse('k1:' + SECRET_1, LEGACY);
end;

{ TKeysClock }

constructor TKeysClock.Create(AUnix: Int64);
begin
  inherited Create;
  FTime := UnixToDateTime(AUnix, False);
end;

function TKeysClock.Now: TDateTime;
begin
  Result := FTime;
end;

function TKeysClock.Date: TDateTime;
begin
  Result := Trunc(FTime);
end;

procedure UseClock(AUnix: Int64);
begin
  TClock.SetClock(TKeysClock.Create(AUnix));
end;

{ TJwtKidTests }

procedure TJwtKidTests.Sign_WithKid_PythonVector;
begin
  TAssert.AssertEquals(KID_TOKEN, TJwt.SignHS256(JWT_IO_CLAIMS, JWT_IO_SECRET, 'k1'));
  TAssert.AssertEquals('k1', KidOf(KID_TOKEN));
end;

procedure TJwtKidTests.Sign_WithKid_EscapedAndReadBack;
var
  LToken: string;
begin
  // A quote in the kid must not end the header's string.
  LToken := TJwt.SignHS256(JWT_IO_CLAIMS, JWT_IO_SECRET, 'a"b\c');
  TAssert.AssertEquals('a"b\c', KidOf(LToken));
  TAssert.AssertTrue(TJwt.Validate(LToken, JWT_IO_SECRET));
end;

procedure TJwtKidTests.Sign_WithKid_RefusesEmptyOrLong;
begin
  TAssert.AssertTrue('empty', StartsWith('EArgumentException', SignKidError('')));
  TAssert.AssertTrue('129 bytes', StartsWith('EArgumentException',
    SignKidError(StringOfChar('k', JWT_MAX_KID_BYTES + 1))));
  TAssert.AssertEquals('128 bytes', '', SignKidError(StringOfChar('k', JWT_MAX_KID_BYTES)));
  // Bytes, not characters, whatever Length says on each compiler: 64
  // two-byte characters fit, one more byte doesn't.
  TAssert.AssertEquals('64 x 2 bytes', '', SignKidError(TwoByteKid));
  TAssert.AssertTrue('64 x 2 bytes + 1', StartsWith('EArgumentException',
    SignKidError(TwoByteKid + 'k')));
end;

procedure TJwtKidTests.ReadKid_Absent;
var
  LKid: string;
begin
  LKid := 'x';
  TAssert.AssertEquals(Ord(jrValid), Ord(TJwt.ReadKid(TJwt.SignHS256(JWT_IO_CLAIMS,
    JWT_IO_SECRET), LKid)));
  TAssert.AssertEquals('', LKid);
end;

procedure TJwtKidTests.ReadKid_Malformed;

  function Header(const AJson: string): TJwtResult;
  var
    LKid: string;
  begin
    // ReadKid reads only the header: the rest of the token may be anything.
    Result := TJwt.ReadKid(B64(AJson) + '.x.y', LKid);
  end;

var
  LKid: string;
begin
  TAssert.AssertEquals('empty token', Ord(jrMalformed), Ord(TJwt.ReadKid('', LKid)));
  TAssert.AssertEquals('no dot', Ord(jrMalformed), Ord(TJwt.ReadKid('abc', LKid)));
  TAssert.AssertEquals('empty header', Ord(jrMalformed), Ord(TJwt.ReadKid('.x.y', LKid)));
  TAssert.AssertEquals('not base64url', Ord(jrMalformed), Ord(TJwt.ReadKid('a*b.x.y', LKid)));
  TAssert.AssertEquals('not an object', Ord(jrMalformed), Ord(Header('[1]')));
  TAssert.AssertEquals('number', Ord(jrMalformed), Ord(Header('{"alg":"HS256","kid":7}')));
  TAssert.AssertEquals('null', Ord(jrMalformed), Ord(Header('{"alg":"HS256","kid":null}')));
  TAssert.AssertEquals('empty', Ord(jrMalformed), Ord(Header('{"alg":"HS256","kid":""}')));
  TAssert.AssertEquals('too long', Ord(jrMalformed),
    Ord(Header('{"alg":"HS256","kid":"' + StringOfChar('k', JWT_MAX_KID_BYTES + 1) + '"}')));
  TAssert.AssertEquals('fits', Ord(jrValid),
    Ord(Header('{"alg":"HS256","kid":"' + StringOfChar('k', JWT_MAX_KID_BYTES) + '"}')));
end;

procedure TJwtKidTests.Decode_IgnoresKid;
var
  LClaims: TJsonValue;
begin
  // TJwt.Decode verifies with the secret it is given, whatever the kid says.
  TAssert.AssertEquals(Ord(jrValid), Ord(TJwt.Decode(KID_TOKEN, JWT_IO_SECRET, LClaims)));
  LClaims.Free;
end;

{ TJwtKeyRingTests }

procedure TJwtKeyRingTests.Setup;
begin
  UseClock(NOW_UNIX);
end;

procedure TJwtKeyRingTests.TearDown;
begin
  TClock.Reset;
end;

procedure TJwtKeyRingTests.Parse_FirstKeySigns;
var
  LRing: IJwtKeyRing;
  LKey: TJwtKey;
begin
  LRing := TStaticJwtKeyRing.Parse('k2:' + SECRET_2 + ',k1:' + SECRET_1, LEGACY, 3600);
  TAssert.AssertTrue(LRing.SigningKey(LKey));
  TAssert.AssertEquals('k2', LKey.Kid);
  TAssert.AssertEquals(SECRET_2, LKey.Secret);
  TAssert.AssertEquals(Int64(0), LKey.NotAfter);
  TAssert.AssertTrue(LRing.FindKey('k1', LKey));
  TAssert.AssertEquals(SECRET_1, LKey.Secret);
  TAssert.AssertFalse('kids are case-sensitive', LRing.FindKey('K1', LKey));
  TAssert.AssertEquals(LEGACY, LRing.LegacySecret);
  TAssert.AssertEquals(Int64(3600), LRing.MaxTokenSeconds);
  TAssert.AssertEquals('k2', KidOf(TJwtKeys.Sign(LRing, Claims(NOW_UNIX + 60))));
end;

procedure TJwtKeyRingTests.Parse_NotAfterAndSpaces;
var
  LRing: IJwtKeyRing;
  LKey: TJwtKey;
begin
  // A secret may hold ':' (only the first one ends the kid).
  LRing := TStaticJwtKeyRing.Parse('  k2 : a:b:c , k1:' + SECRET_1 + ' @ 1800000000  ');
  TAssert.AssertTrue(LRing.FindKey('k2', LKey));
  TAssert.AssertEquals('a:b:c', LKey.Secret);
  TAssert.AssertTrue(LRing.FindKey('k1', LKey));
  TAssert.AssertEquals(SECRET_1, LKey.Secret);
  TAssert.AssertEquals(Int64(1800000000), LKey.NotAfter);
  TAssert.AssertEquals('', LRing.LegacySecret);
end;

procedure TJwtKeyRingTests.Parse_Invalid;

  procedure Refused(const AText: string);
  begin
    TAssert.AssertTrue(AText, StartsWith('EJwtKeyError', ParseError(AText)));
  end;

begin
  Refused('');                    // no key and no legacy secret
  Refused('   ');
  Refused('k1');                  // no ':'
  Refused('k1:');                 // empty secret
  Refused('k1:  ');
  Refused(':secret');             // empty kid
  Refused('k 1:secret');          // kid charset
  Refused('k/1:secret');          // '/' is reserved for tenant kids (phase 3)
  Refused('k1:secret,');          // an empty entry
  Refused(',k1:secret');
  Refused('k1:a,,k2:b');
  Refused('k1:a,k1:b');           // repeated kid
  Refused('k1:secret@');          // notAfter not digits
  Refused('k1:secret@abc');
  Refused('k1:secret@$10');
  Refused('k1:secret@0x10');
  Refused('k1:secret@+10');
  Refused('k1:secret@-10');
  Refused('k1:secret@0');
  Refused('k1:secret@1@2');       // a secret has no '@'
  Refused('k1:sec@ret@1800000000');
  Refused('k1:secret@9999999999999999999');
  Refused(StringOfChar('k', JWT_MAX_KID_BYTES + 1) + ':secret');
  TAssert.AssertEquals('128-byte kid', '',
    ParseError(StringOfChar('k', JWT_MAX_KID_BYTES) + ':secret'));
end;

procedure TJwtKeyRingTests.Parse_ErrorsNeverShowTheSecret;
var
  LError: string;
begin
  LError := ParseError('k1:' + SECRET_1 + '@abc');
  TAssert.AssertTrue(LError, LError <> '');
  TAssert.AssertTrue(LError, Pos(SECRET_1, LError) = 0);
  LError := ParseError('k1:' + SECRET_1 + ',k1:' + SECRET_2);
  TAssert.AssertTrue(LError, Pos(SECRET_1, LError) + Pos(SECRET_2, LError) = 0);
  LError := ParseError(SECRET_1);
  TAssert.AssertTrue(LError, Pos(SECRET_1, LError) = 0);
end;

procedure TJwtKeyRingTests.Create_Invalid;
begin
  TAssert.AssertTrue(StartsWith('EJwtKeyError', CreateError([], '')));
  TAssert.AssertEquals('only a legacy secret', '', CreateError([], LEGACY));
  TAssert.AssertTrue(StartsWith('EJwtKeyError', CreateError([TJwtKey.Create('k1', '')], LEGACY)));
  TAssert.AssertTrue(StartsWith('EJwtKeyError', CreateError([TJwtKey.Create('', 'x')], LEGACY)));
  TAssert.AssertTrue(StartsWith('EJwtKeyError',
    CreateError([TJwtKey.Create('k1', 'x'), TJwtKey.Create('k1', 'y')], '')));
end;

procedure TJwtKeyRingTests.Rotation_OldTokenStillVerifies;
var
  LOld, LNew: IJwtKeyRing;
  LOldToken, LNewToken: string;
begin
  LOld := TStaticJwtKeyRing.Parse('k1:' + SECRET_1);
  LOldToken := TJwtKeys.Sign(LOld, Claims(NOW_UNIX + 3600));
  // The rotation: k2 signs, k1 verifies for one more hour.
  LNew := TStaticJwtKeyRing.Parse(Format('k2:%s,k1:%s@%d', [SECRET_2, SECRET_1, NOW_UNIX + 3600]));
  LNewToken := TJwtKeys.Sign(LNew, Claims(NOW_UNIX + 3600));
  TAssert.AssertEquals('k2', KidOf(LNewToken));
  TAssert.AssertEquals('old token, new ring', Ord(jrValid), Ord(DecodeWith(LNew, LOldToken)));
  TAssert.AssertEquals('new token, new ring', Ord(jrValid), Ord(DecodeWith(LNew, LNewToken)));
  TAssert.AssertEquals('new token, old ring', Ord(jrBadSignature), Ord(DecodeWith(LOld, LNewToken)));
end;

procedure TJwtKeyRingTests.Decode_UnknownKid_BadSignature;
var
  LToken: string;
begin
  LToken := TJwt.SignHS256(Claims(NOW_UNIX + 60), SECRET_1, 'k9');
  TAssert.AssertEquals(Ord(jrBadSignature), Ord(DecodeWith(OneRing, LToken)));
end;

procedure TJwtKeyRingTests.Decode_KeyNotAfterBoundary;
var
  LRing: IJwtKeyRing;
  LToken: string;
begin
  LRing := TStaticJwtKeyRing.Parse(Format('k2:%s,k1:%s@%d', [SECRET_2, SECRET_1, NOW_UNIX + 10]));
  LToken := TJwt.SignHS256(Claims(NOW_UNIX + 3600), SECRET_1, 'k1');
  UseClock(NOW_UNIX + 9);
  TAssert.AssertEquals('one second before', Ord(jrValid), Ord(DecodeWith(LRing, LToken)));
  UseClock(NOW_UNIX + 10);
  TAssert.AssertEquals('at NotAfter', Ord(jrBadSignature), Ord(DecodeWith(LRing, LToken)));
end;

procedure TJwtKeyRingTests.Decode_KidWithAnotherKeysSecret_BadSignature;
var
  LRing: IJwtKeyRing;
begin
  LRing := TStaticJwtKeyRing.Parse('k2:' + SECRET_2 + ',k1:' + SECRET_1, LEGACY);
  // The kid commits the token to one key: neither another key nor the legacy
  // secret verifies it.
  TAssert.AssertEquals('k1 named, k2 signed', Ord(jrBadSignature),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), SECRET_2, 'k1'))));
  TAssert.AssertEquals('k1 named, legacy signed', Ord(jrBadSignature),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), LEGACY, 'k1'))));
end;

procedure TJwtKeyRingTests.Decode_MalformedKid;
var
  LHeader, LPayload: string;
begin
  LHeader := B64('{"alg":"HS256","typ":"JWT","kid":7}');
  LPayload := B64(Claims(NOW_UNIX + 60));
  TAssert.AssertEquals(Ord(jrMalformed),
    Ord(DecodeWith(OneRing, LHeader + '.' + LPayload + '.x')));
  TAssert.AssertEquals('garbage', Ord(jrMalformed), Ord(DecodeWith(OneRing, 'abc')));
end;

procedure TJwtKeyRingTests.Decode_NoKid_LegacySecret;
begin
  TAssert.AssertEquals('legacy token', Ord(jrValid),
    Ord(DecodeWith(OneRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), LEGACY))));
  TAssert.AssertEquals('no kid, a key''s secret', Ord(jrBadSignature),
    Ord(DecodeWith(OneRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), SECRET_1))));
end;

procedure TJwtKeyRingTests.Decode_NoKid_WithoutLegacy_Refused;
var
  LRing: IJwtKeyRing;
begin
  LRing := TStaticJwtKeyRing.Parse('k1:' + SECRET_1);
  TAssert.AssertEquals(Ord(jrBadSignature),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), SECRET_1))));
  // An empty key signs nothing either.
  TAssert.AssertEquals('empty key', Ord(jrBadSignature),
    Ord(DecodeWith(LRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), ''))));
end;

procedure TJwtKeyRingTests.Decode_NilRing_Refused;
begin
  TAssert.AssertEquals(Ord(jrBadSignature), Ord(DecodeWith(nil, KID_TOKEN)));
end;

procedure TJwtKeyRingTests.Decode_StillChecksExp;
var
  LToken: string;
begin
  LToken := TJwtKeys.Sign(OneRing, Claims(NOW_UNIX + 60));
  UseClock(NOW_UNIX + 60);
  TAssert.AssertEquals(Ord(jrExpired), Ord(DecodeWith(OneRing, LToken)));
end;

procedure TJwtKeyRingTests.Sign_NoSigningKey;
var
  LRing: IJwtKeyRing;
begin
  LRing := TStaticJwtKeyRing.Create([], LEGACY);
  TAssert.AssertTrue('only a legacy secret',
    StartsWith('EJwtKeyError', SignError(LRing, Claims(NOW_UNIX + 60))));
  LRing := TStaticJwtKeyRing.Parse(Format('k1:%s@%d', [SECRET_1, NOW_UNIX]));
  TAssert.AssertTrue('signing key past NotAfter',
    StartsWith('EJwtKeyError', SignError(LRing, Claims(NOW_UNIX + 60))));
  TAssert.AssertTrue('nil ring', StartsWith('EArgumentException', SignError(nil, Claims(NOW_UNIX + 60))));
end;

procedure TJwtKeyRingTests.Sign_LifetimeRules;
var
  LRing: IJwtKeyRing;
begin
  LRing := TStaticJwtKeyRing.Parse(Format('k1:%s@%d', [SECRET_1, NOW_UNIX + 7200]), '', 3600);
  TAssert.AssertEquals('within both', '', SignError(LRing, Claims(NOW_UNIX + 3600)));
  TAssert.AssertTrue('past MaxTokenSeconds',
    StartsWith('EArgumentException', SignError(LRing, Claims(NOW_UNIX + 3601))));
  TAssert.AssertTrue('no exp',
    StartsWith('EArgumentException', SignError(LRing, '{"sub":"ana"}')));
  TAssert.AssertTrue('exp not a number',
    StartsWith('EArgumentException', SignError(LRing, '{"sub":"ana","exp":"1700000060"}')));
  TAssert.AssertTrue('exp not an integer',
    StartsWith('EArgumentException', SignError(LRing, '{"sub":"ana","exp":1700000060.5}')));
  TAssert.AssertTrue('not an object', StartsWith('EArgumentException', SignError(LRing, '[1]')));
  TAssert.AssertTrue('not JSON', StartsWith('EArgumentException', SignError(LRing, '{"exp":')));

  // No MaxTokenSeconds: only the key's NotAfter bounds exp.
  LRing := TStaticJwtKeyRing.Parse(Format('k1:%s@%d', [SECRET_1, NOW_UNIX + 7200]));
  TAssert.AssertEquals('at NotAfter', '', SignError(LRing, Claims(NOW_UNIX + 7200)));
  TAssert.AssertTrue('past NotAfter',
    StartsWith('EArgumentException', SignError(LRing, Claims(NOW_UNIX + 7201))));
  LRing := TStaticJwtKeyRing.Parse('k1:' + SECRET_1);
  TAssert.AssertEquals('no bound at all', '', SignError(LRing, Claims(NOW_UNIX + 10 * 365 * 86400)));
end;

procedure TJwtKeyRingTests.Validate_MatchesDecode;
begin
  TAssert.AssertTrue(TJwtKeys.Validate(OneRing, TJwtKeys.Sign(OneRing, Claims(NOW_UNIX + 60))));
  TAssert.AssertFalse(TJwtKeys.Validate(OneRing, TJwt.SignHS256(Claims(NOW_UNIX + 60), SECRET_2, 'k1')));
end;

initialization
  RegisterTest(TJwtKidTests);
  RegisterTest(TJwtKeyRingTests);

end.
