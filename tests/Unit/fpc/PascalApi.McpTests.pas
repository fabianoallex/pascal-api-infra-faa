{ TFakeExecutor }

function TFakeExecutor.Execute(const AMethod, APathAndQuery, ABody: string;
  const AForward: TMcpForward; out AStatus: Integer): string;
begin
  Inc(Calls);
  Method := AMethod;
  PathAndQuery := APathAndQuery;
  Body := ABody;
  Forwarded := AForward;
  if Fail then
    raise Exception.Create('connection refused');
  AStatus := Status;
  Result := Answer;
end;

