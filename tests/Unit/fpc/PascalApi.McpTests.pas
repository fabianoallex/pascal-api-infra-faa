// A header parameter the route doesn't opt in (McpHeaders, 0.25.0) is left
// out of the tool's arguments.
procedure TMcpTests.Catalog_HeaderParamsAreNotArguments;
var
  LOp: TApiOperation;
begin
  LOp := Op('delete', '/cities/:code');
  SetLength(LOp.Params, 1);
  LOp.Params[0].Name := 'If-Match';
  LOp.Params[0].Description := '';
  LOp.Params[0].Location := plHeader;
  LOp.Params[0].ParamType := ptString;
  LOp.Params[0].Required := True;
  Server([]);
  TAssert.AssertEquals(1, Length(FServer.Tools[0].Args));
  TAssert.AssertEquals('code', FServer.Tools[0].Args[0].Name);
  TAssert.AssertEquals('{"type":"object","properties":{"code":{"type":"string"}},' +
    '"required":["code"],"additionalProperties":false}', FServer.Tools[0].InputSchema);
end;

procedure TMcpTests.McpHeaderArgName_Rule;
begin
  TAssert.AssertEquals('ifMatch', McpHeaderArgName('If-Match'));
  TAssert.AssertEquals('idempotencyKey', McpHeaderArgName('Idempotency-Key'));
  TAssert.AssertEquals('xRequestId', McpHeaderArgName('X-REQUEST-ID'));
  TAssert.AssertEquals('etag', McpHeaderArgName('ETag'));
  TAssert.AssertEquals('a_b', McpHeaderArgName('a_b'));
end;

procedure TMcpTests.McpHeaderReserved_TransportHeaders;
const
  RESERVED: array[0..23] of string = ('Authorization', 'x-forwarded-for', 'Traceparent',
    'tracestate', 'Host', 'Content-Type', 'CONTENT-LENGTH', 'MCP-Protocol-Version', 'Mcp-Method',
    'Mcp-Name', 'Mcp-Session-Id', 'Accept', 'Cookie', 'Forwarded', 'X-Forwarded-Host',
    'X-Forwarded-Proto', 'X-Real-IP', 'Connection', 'Transfer-Encoding', 'TE', 'Upgrade',
    'Keep-Alive', 'Proxy-Authorization', 'Expect');
var
  I: Integer;
begin
  for I := 0 to High(RESERVED) do
    TAssert.AssertTrue(RESERVED[I], McpHeaderReserved(RESERVED[I]));
  TAssert.AssertFalse(McpHeaderReserved('If-Match'));
  TAssert.AssertFalse(McpHeaderReserved('Idempotency-Key'));
  TAssert.AssertFalse(McpHeaderReserved('X-Forwarded')); // only the X-Forwarded-* family
  TAssert.AssertFalse(McpHeaderReserved('Mcp')); // only Mcp-*
end;

procedure TMcpTests.Catalog_McpHeader_ArgumentsAndSchema;
var
  LArg: TMcpArg;
begin
  BuildReplace;
  Server([]);
  TAssert.AssertEquals(5, Length(FServer.Tools[0].Args));
  TAssert.AssertTrue(FServer.Tools[0].FindArg('ifMatch', LArg));
  TAssert.AssertTrue(LArg.Location = alHeader);
  TAssert.AssertEquals('If-Match', LArg.Header); // the declared spelling
  TAssert.AssertTrue(LArg.Required);
  TAssert.AssertTrue(FServer.Tools[0].FindArg('key', LArg));
  TAssert.AssertEquals('Idempotency-Key', LArg.Header);
  TAssert.AssertFalse(LArg.Required);
  TAssert.AssertFalse(FServer.Tools[0].FindArg('xClient', LArg));
  // Path, then headers, then the body; the header's description and name.
  TAssert.AssertEquals('{"type":"object","properties":{"code":{"type":"string"},' +
    '"ifMatch":{"type":"string","description":"The ETag read, as in \"3\" (sent as the ' +
    'If-Match header)"},"key":{"type":"string","description":"Sent as the Idempotency-Key ' +
    'header"},"name":{"type":"string"},"population":{"type":"integer","format":"int32"}},' +
    '"required":["code","ifMatch","name"],"additionalProperties":false}',
    FServer.Tools[0].InputSchema);
end;

procedure TMcpTests.Catalog_McpHeader_Undeclared_Raises;
var
  LOp: TApiOperation;
  LMessage: string;
begin
  LOp := Op('put', '/cities/:code');
  AddParam(LOp, 'If-Match', plQuery, ptString, False); // a query parameter, not a header
  AddMcpHeader(LOp, 'If-Match');
  LMessage := CatalogError;
  TAssert.AssertTrue(LMessage, Pos('"If-Match"', LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('no header parameter', LMessage) > 0);
end;

procedure TMcpTests.Catalog_McpHeader_Reserved_Raises;
const
  RESERVED: array[0..3] of string = ('Authorization', 'traceparent', 'Content-Type', 'Mcp-Name');
var
  I: Integer;
  LOp: TApiOperation;
  LMessage: string;
begin
  for I := 0 to High(RESERVED) do
  begin
    FreeAndNil(FServer);
    FreeAndNil(FDoc);
    FDoc := TApiDocument.Create(FMapper);
    LOp := Op('get', '/cities');
    AddParam(LOp, RESERVED[I], plHeader, ptString, False);
    AddMcpHeader(LOp, RESERVED[I], 'value');
    LMessage := CatalogError;
    TAssert.AssertTrue(RESERVED[I] + ': ' + LMessage, Pos('"' + RESERVED[I] + '"', LMessage) > 0);
    TAssert.AssertTrue(LMessage, Pos('can''t be a tool argument', LMessage) > 0);
  end;
end;

procedure TMcpTests.Catalog_McpHeader_NameCollision_Raises;
var
  LOp: TApiOperation;
  LMessage: string;
begin
  // The derived name against a query parameter.
  LOp := Op('get', '/cities');
  AddParam(LOp, 'ifMatch', plQuery, ptString, False);
  AddParam(LOp, 'If-Match', plHeader, ptString, False);
  AddMcpHeader(LOp, 'If-Match');
  LMessage := CatalogError;
  TAssert.AssertTrue(LMessage, Pos('"ifMatch"', LMessage) > 0);

  // A given name against a body member.
  FreeAndNil(FDoc);
  FDoc := TApiDocument.Create(FMapper);
  LOp := Op('post', '/cities');
  LOp.Body := TypeInfo(ICityIn);
  AddParam(LOp, 'If-Match', plHeader, ptString, False);
  AddMcpHeader(LOp, 'If-Match', 'name');
  LMessage := CatalogError;
  TAssert.AssertTrue(LMessage, Pos('"name"', LMessage) > 0);

  // One header opted in twice.
  FreeAndNil(FDoc);
  FDoc := TApiDocument.Create(FMapper);
  LOp := Op('post', '/cities');
  AddParam(LOp, 'If-Match', plHeader, ptString, False);
  AddMcpHeader(LOp, 'If-Match');
  AddMcpHeader(LOp, 'If-Match', 'version');
  LMessage := CatalogError;
  TAssert.AssertTrue(LMessage, Pos('"If-Match"', LMessage) > 0);
end;

procedure TMcpTests.Call_HeaderArgument_SentAsHeader;
begin
  BuildReplace;
  TAssert.AssertTrue(Pos('"isError":false', Call('replace_city',
    '{"code":"1","ifMatch":"\"3\"","key":"k-1","name":"Lages"}')) > 0);
  TAssert.AssertEquals('PUT', FFake.Method);
  TAssert.AssertEquals('/cities/1', FFake.PathAndQuery);
  TAssert.AssertEquals('{"name":"Lages"}', FFake.Body); // the headers stay out of the body
  TAssert.AssertEquals(2, Length(FFake.Forwarded.Headers));
  TAssert.AssertEquals('If-Match', FFake.Forwarded.Headers[0].Name);
  TAssert.AssertEquals('"3"', FFake.Forwarded.Headers[0].Value);
  TAssert.AssertEquals('Idempotency-Key', FFake.Forwarded.Headers[1].Name);
  TAssert.AssertEquals('k-1', FFake.Forwarded.Headers[1].Value);
  // The transport's headers still pass on.
  TAssert.AssertEquals('Bearer abc', FFake.Forwarded.Authorization);

  // An optional one left out (or null) sends no header.
  Call('replace_city', '{"code":"1","ifMatch":"\"3\"","key":null,"name":"Lages"}');
  TAssert.AssertEquals(1, Length(FFake.Forwarded.Headers));
  TAssert.AssertEquals('If-Match', FFake.Forwarded.Headers[0].Name);
  TAssert.AssertEquals(2, FFake.Calls);
end;

procedure TMcpTests.Call_HeaderArgument_RefusedWithoutCalling;
const
  NON_ASCII: string = 'São';
var
  LJson: TJsonWriter;
  LArgs: string;
begin
  BuildReplace;
  TAssert.AssertTrue(Pos('"text":"Missing required argument: ifMatch"}],"isError":true',
    Call('replace_city', '{"code":"1","name":"Lages"}')) > 0);
  // An empty value is no value.
  TAssert.AssertTrue(Pos('"text":"Missing required argument: ifMatch"}],"isError":true',
    Call('replace_city', '{"code":"1","ifMatch":"","name":"Lages"}')) > 0);
  TAssert.AssertTrue(Pos('"text":"Argument ifMatch: a header value must be a string"}],' +
    '"isError":true', Call('replace_city', '{"code":"1","ifMatch":3,"name":"Lages"}')) > 0);
  // A line break would start another header.
  TAssert.AssertTrue(Pos('"text":"Argument key: a header value must be printable ASCII ' +
    '(no accents, no control characters)"}],"isError":true', Call('replace_city',
    '{"code":"1","ifMatch":"\"3\"","key":"a\r\nAuthorization: x","name":"Lages"}')) > 0);
  // Non-ASCII, written by the JSON writer as the client's SDK would send it.
  LJson := TJsonWriter.Create;
  try
    LJson.BeginObject;
    LJson.Name('code');
    LJson.WriteString('1');
    LJson.Name('ifMatch');
    LJson.WriteString(NON_ASCII);
    LJson.Name('name');
    LJson.WriteString('Lages');
    LJson.EndObject;
    LArgs := LJson.ToString;
  finally
    LJson.Free;
  end;
  TAssert.AssertTrue(Pos('"text":"Argument ifMatch: a header value must be printable ASCII',
    Call('replace_city', LArgs)) > 0);
  TAssert.AssertEquals(0, FFake.Calls);
end;

