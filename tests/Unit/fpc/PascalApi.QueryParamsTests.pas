// The required members a test didn't set, with neutral values, then Read.
function TQueryParamsTests.Read: IQpFind;

  procedure Fill(const AName, AValue: string);
  begin
    if FValues.IndexOfName(AName) < 0 then
      FValues.Add(AName + '=' + AValue);
  end;

begin
  Fill('ratio', '0');
  Fill('kind', 'qkPlain');
  Fill('at', '2026-01-01T00:00:00Z');
  Fill('count', '0');
  Result := TQueryParams.Read<IQpFind>(TJsonMapper.Shared, FValues);
end;

// Read on FValues as they are: 'field code' per failure, comma-separated,
// or '' when nothing was raised.
function TQueryParamsTests.RequiredFailures: string;
var
  I: Integer;
begin
  Result := '';
  try
    TQueryParams.Read<IQpFind>(TJsonMapper.Shared, FValues);
  except
    on E: EPcValidationError do
      for I := 0 to High(E.Errors) do
      begin
        if Result <> '' then
          Result := Result + ',';
        Result := Result + E.Errors[I].Field + ' ' + E.Errors[I].Code;
      end;
  end;
end;

// The 400's status and message, or '' when Read raised nothing.
function TQueryParamsTests.Error: string;
begin
  Result := '';
  try
    Read;
  except
    on E: EValidationException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Message;
  end;
end;

procedure TQueryParamsTests.Nothing_LeavesEveryOptionalAbsent;
var
  F: IQpFind;
begin
  F := Read;
  TAssert.AssertFalse(F.Page.HasValue);
  TAssert.AssertFalse(F.Limit.HasValue);
  TAssert.AssertFalse(F.OrderBy.HasValue);
  TAssert.AssertFalse(F.Search.HasValue);
  TAssert.AssertFalse(TOptionals.Safe(Dto(F).Active).HasValue);
  TAssert.AssertEquals(0, Dto(F).Count);
end;

procedure TQueryParamsTests.EveryKind_IsRead;
var
  F: IQpFind;
begin
  FValues.Add('page=2');
  FValues.Add('limit=10');
  FValues.Add('orderBy=-name');
  FValues.Add('search=São Paulo');
  FValues.Add('active=false');
  FValues.Add('minPrice=12.5');
  FValues.Add('ratio=1.5e2');
  FValues.Add('kind=qkSpecial');
  FValues.Add('at=2026-12-24T10:00:00-03:00');
  FValues.Add('count=-3');
  F := Read;
  TAssert.AssertEquals(2, F.Page.Value);
  TAssert.AssertEquals(10, F.Limit.Value);
  TAssert.AssertEquals('-name', F.OrderBy.Value);
  TAssert.AssertEquals('São Paulo', F.Search.Value);
  TAssert.AssertTrue(Dto(F).Active.HasValue);
  TAssert.AssertFalse(Dto(F).Active.Value);
  TAssert.AssertEquals(Currency(12.5), Dto(F).MinPrice.Value);
  TAssert.AssertEquals(150, Dto(F).Ratio, 0);
  TAssert.AssertTrue(Dto(F).Kind = qkSpecial);
  TAssert.AssertEquals(EncodeDateTime(2026, 12, 24, 13, 0, 0, 0), Dto(F).At, 1 / MSecsPerDay / 2);
  TAssert.AssertEquals(-3, Dto(F).Count);
end;

// 0.23.0: the members the document marks required (not optionals) that the
// query lacks, each a "required" failure, in one 400; until 0.22.0 they
// were read as '' or 0.
procedure TQueryParamsTests.Required_Missing_IsAFieldFailureEach;
var
  LMessage: string;
begin
  TAssert.AssertEquals('ratio required,kind required,at required,count required',
    RequiredFailures);
  FValues.Add('count=2');
  FValues.Add('at=2026-01-01T00:00:00Z');
  TAssert.AssertEquals('ratio required,kind required', RequiredFailures);
  LMessage := '';
  try
    TQueryParams.Read<IQpFind>(TJsonMapper.Shared, FValues);
  except
    on E: EPcValidationError do
      LMessage := E.Errors[0].Message;
  end;
  TAssert.AssertEquals('"ratio" is required.', LMessage);
end;

procedure TQueryParamsTests.Required_EmptyOrBlank_IsMissing;
begin
  FValues.Add('ratio=');
  FValues.Add('kind=   ');
  FValues.Add('at=2026-01-01T00:00:00Z');
  FValues.Add('count=0');
  TAssert.AssertEquals('ratio required,kind required', RequiredFailures);
end;

procedure TQueryParamsTests.Empty_IsAbsent;
var
  F: IQpFind;
begin
  FValues.Add('search=');
  FValues.Add('page=');
  F := Read;
  TAssert.AssertFalse(F.Search.HasValue);
  TAssert.AssertFalse(F.Page.HasValue);
end;

procedure TQueryParamsTests.Integer_LeadingZeros_AndMinus;
begin
  FValues.Add('page=007');
  FValues.Add('count=-000');
  TAssert.AssertEquals(7, Read.Page.Value);
  TAssert.AssertEquals(0, Dto(Read).Count);
end;

procedure TQueryParamsTests.Integer_NotANumber_Is400;
begin
  FValues.Add('limit=abc');
  TAssert.AssertEquals('400 "limit" must be an integer.', Error);
  FValues.Clear;
  FValues.Add('limit=1.5');
  TAssert.AssertEquals('400 "limit" must be an integer.', Error);
  FValues.Clear;
  FValues.Add('limit=-');
  TAssert.AssertEquals('400 "limit" must be an integer.', Error);
end;

procedure TQueryParamsTests.Integer_OutOfRange_Is400WithoutJsonPath;
begin
  FValues.Add('limit=99999999999');
  TAssert.AssertEquals('400 limit: 99999999999 is out of range (-2147483648..2147483647)', Error);
end;

procedure TQueryParamsTests.Number_Invalid_Is400;
begin
  FValues.Add('minPrice=12,5');
  TAssert.AssertEquals('400 "minPrice" must be a number.', Error);
  FValues.Clear;
  FValues.Add('ratio=.5');
  TAssert.AssertEquals('400 "ratio" must be a number.', Error);
end;

procedure TQueryParamsTests.Boolean_OnlyTrueOrFalse;
begin
  FValues.Add('active=yes');
