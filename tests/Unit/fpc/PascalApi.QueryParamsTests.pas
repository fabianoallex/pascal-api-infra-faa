end;

procedure TQueryParamsTests.Names_IgnoreCase_UnknownIgnored_ArraysSkipped;
var
  F: IQpFind;
begin
  FValues.Add('PAGE=3');
  FValues.Add('_=1729');
  FValues.Add('utm_source=mail');
  FValues.Add('ids=1,2');
