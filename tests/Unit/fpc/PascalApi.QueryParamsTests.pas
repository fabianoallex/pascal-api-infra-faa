procedure TQueryParamsTests.Text_IsEscapedIntoJson;
begin
  FValues.Add('search=a"b\c' + #9 + 'd');
  TAssert.AssertEquals('a"b\c' + #9 + 'd', Read.Search.Value);
end;

procedure TQueryParamsTests.ToJson_ExactText;
begin
  FValues.Add('limit=010');
  FValues.Add('search=x');
  FValues.Add('active=true');
  FValues.Add('ignored=1');
  TAssert.AssertEquals('{"limit":10,"search":"x","active":true}',
    TQueryParams.ToJson(TJsonMapper.Shared, TQpFind, FValues));
end;

