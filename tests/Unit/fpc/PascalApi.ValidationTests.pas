procedure TValidationTests.SetUp;
begin
  FMapper := TJsonMapper.Create;
  FMapper.RegisterConverter(TOptionalsJsonConverter.Create);
  FMapper.RegisterMapping<IVProduct, TVProduct>;
  FMapper.RegisterMapping<IVFind, TVFind>;
  TApiSchema.Describe(TypeInfo(IVProduct), '', FMapper)
    .Prop('Name').MinLength(2).MaxLength(5)
    .Prop('Kind').Enum(['a', 'b'])
    .Prop('Qty').Minimum(1).Maximum(10)
    .Prop('Big').Maximum(100)
    .Prop('Price').Minimum(0)
    .Prop('Ratio').Maximum(1.5)
    .Prop('Nick').MaxLength(3)
    .Prop('Count').Minimum(0);
  TApiSchema.Describe(TypeInfo(IVFind), '', FMapper)
    .Prop('Limit').Minimum(1).Maximum(50);
end;

procedure TValidationTests.TearDown;
begin
  TApiSchema.Clear;
  FMapper.Free;
end;

function TValidationTests.Valid: TVProduct;
begin
  Result := TVProduct.Create;
  Result.Name := 'Ana';
  Result.Kind := 'a';
  Result.Qty := 5;
  Result.Big := 100;
  Result.Price := 0;
  Result.Ratio := 1.5;
end;

// "field:code" of every failure, joined by spaces; '' when none.
function TValidationTests.ErrorsOf(const ADto: IVProduct): string;
var
  LCheck: TPcValidation;
  LErrors: TPcFieldErrors;
  I: Integer;
begin
  LCheck := TPcValidation.Create;
  TApiSchema.Check(TypeInfo(IVProduct), ADto, LCheck, FMapper);
  LErrors := LCheck.Errors;
  Result := '';
  for I := 0 to High(LErrors) do
  begin
    if Result <> '' then
      Result := Result + ' ';
    Result := Result + LErrors[I].Field + ':' + LErrors[I].Code;
  end;
end;

procedure TValidationTests.Check_Valid_NoErrors;
var
  LDto: IVProduct;
begin
  LDto := Valid;
  TAssert.AssertEquals('', ErrorsOf(LDto));
end;

procedure TValidationTests.Check_EveryLimit_InMemberOrder;
var
  LFill: TVProduct;
  LDto: IVProduct;
begin
  LFill := Valid;
  LDto := LFill;
  LFill.Name := 'Ã';         // 1 character (2 UTF-8 bytes on FPC): too short
  LFill.Kind := 'c';
  LFill.Qty := 11;
  LFill.Big := 101;
  LFill.Price := -1;
  LFill.Ratio := 1.6;
  TAssert.AssertEquals('name:too_short kind:not_allowed qty:out_of_range big:above_maximum ' +
    'price:below_minimum ratio:above_maximum', ErrorsOf(LDto));
  LFill.Name := 'Ãbcdef';    // 6 characters: too long
  TAssert.AssertTrue(Pos('name:too_long', ErrorsOf(LDto)) = 1);
end;

procedure TValidationTests.Check_Optionals_OnlyWithAValue;
var
  LFill: TVProduct;
  LDto: IVProduct;
  LNick: IOptString;
  LCount: IOptNullInteger;
begin
  LFill := Valid;
  LDto := LFill;
  LNick := TOptNullString.Undefined;
  LCount := TOptNullInteger.Null;
  LFill.Nick := LNick;
  LFill.Count := LCount;
  TAssert.AssertEquals('absent and null are not checked', '', ErrorsOf(LDto));
  LNick := TOptNullString.From('abcd');
  LCount := TOptNullInteger.From(-1);
  LFill.Nick := LNick;
  LFill.Count := LCount;
  TAssert.AssertEquals('nick:too_long count:below_minimum', ErrorsOf(LDto));
end;

procedure TValidationTests.Check_NoDescription_Nothing;
var
  LCheck: TPcValidation;
  LFind: IVFind;
begin
  TApiSchema.Clear;
  LFind := TVFind.Create;
  LCheck := TPcValidation.Create;
  TApiSchema.Check(TypeInfo(IVFind), LFind, LCheck, FMapper);
  TAssert.AssertTrue(LCheck.IsValid);
end;

procedure TValidationTests.FromJson_RaisesEveryField;
var
  LRaised: Boolean;
begin
  LRaised := False;
  try
    TApiInput.FromJson<IVProduct>('{"name":"A","kind":"a","qty":0,"big":1,"price":1,"ratio":1}',
      FMapper);
  except
    on E: EPcValidationError do
    begin
      LRaised := True;
      TAssert.AssertEquals(2, Length(E.Errors));
      TAssert.AssertEquals('name', E.Errors[0].Field);
      TAssert.AssertEquals('"name" must have at least 2 characters.', E.Errors[0].Message);
      TAssert.AssertEquals('qty', E.Errors[1].Field);
      TAssert.AssertEquals('"qty" must be from 1 to 10.', E.Errors[1].Message);
    end;
  end;
  TAssert.AssertTrue(LRaised);
end;

procedure TValidationTests.QueryParams_DescribedLimit;
var
  LValues: TStringList;
  LRaised: Boolean;
begin
  LValues := TStringList.Create;
  try
    LValues.Add('limit=60');
    LRaised := False;
    try
      TQueryParams.Read<IVFind>(FMapper, LValues);
    except
      on E: EPcValidationError do
      begin
        LRaised := True;
        TAssert.AssertEquals('limit', E.Errors[0].Field);
        TAssert.AssertEquals('out_of_range', E.Errors[0].Code);
      end;
    end;
    TAssert.AssertTrue(LRaised);
    LValues.Clear;
    LValues.Add('limit=50');
    TAssert.AssertEquals(50, TQueryParams.Read<IVFind>(FMapper, LValues).Limit.Value);
  finally
    LValues.Free;
  end;
end;

function TwoErrors: TPcFieldErrors;
begin
  Result := nil;
  SetLength(Result, 2);
  Result[0].Field := 'name';
  Result[0].Code := 'required';
  Result[0].Message := '"name" is required.';
  Result[1].Field := 'qty';
  Result[1].Code := 'out_of_range';
  Result[1].Message := '"qty" must be from 1 to 10.';
end;

procedure TValidationTests.MapException_InvalidFields;
var
  E: EPcValidationError;
  LError: TErrorResponse;
begin
  E := EPcValidationError.Create(TwoErrors);
  try
    LError := MapException(E, 'POST', '/products');
  finally
    E.Free;
  end;
  TAssert.AssertEquals(400, LError.Status);
  TAssert.AssertEquals('the first field''s message', '"name" is required.', LError.Message);
  TAssert.AssertEquals('invalid_fields', LError.Code);
  TAssert.AssertEquals(2, Length(LError.Fields));
  TAssert.AssertEquals('a client error: not logged', '', LError.LogLine);
end;

procedure TValidationTests.ErrorJson_WithFields;
begin
  TAssert.AssertEquals('{"error":"\"name\" is required.","code":"invalid_fields","fields":[' +
    '{"field":"name","code":"required","message":"\"name\" is required."},' +
    '{"field":"qty","code":"out_of_range","message":"\"qty\" must be from 1 to 10."}]}',
    ErrorJson('"name" is required.', '', 'invalid_fields', TwoErrors));
  TAssert.AssertEquals('no fields: as before', '{"error":"x"}', ErrorJson('x', '', '', nil));
end;

initialization
  RegisterTest(TValidationTests);

end.
