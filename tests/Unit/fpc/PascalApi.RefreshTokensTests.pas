implementation

const
  T0 = 1798117200; // 2026-12-24T13:00:00Z

{ TRefreshClock }

constructor TRefreshClock.Create(AUnix: Int64);
begin
  inherited Create;
  FTime := UnixToDateTime(AUnix, False);
end;

function TRefreshClock.Now: TDateTime;
begin
  Result := FTime;
end;

function TRefreshClock.Date: TDateTime;
begin
  Result := Trunc(FTime);
end;

procedure UseClock(AUnix: Int64);
begin
  TClock.SetClock(TRefreshClock.Create(AUnix));
end;

{ TRacingStore }

constructor TRacingStore.Create;
begin
  inherited Create;
  FInner := TMemoryRefreshTokenStore.Create;
end;

procedure TRacingStore.Add(const AScope, AHash: string; const ARecord: TRefreshTokenRecord;
  ACreatedAt: Int64);
begin
  if RevokeBeforeNextAdd then
  begin
    RevokeBeforeNextAdd := False;
    FInner.RevokeFamily(AScope, ARecord.FamilyId, ACreatedAt);
  end;
  FInner.Add(AScope, AHash, ARecord, ACreatedAt);
end;

function TRacingStore.FindByHash(const AScope, AHash: string;
  out ARecord: TRefreshTokenRecord): Boolean;
begin
  Result := FInner.FindByHash(AScope, AHash, ARecord);
end;

function TRacingStore.MarkUsed(const AScope, AId: string; AAt: Int64): Boolean;
begin
  Result := FInner.MarkUsed(AScope, AId, AAt) and not LoseNextMark;
  LoseNextMark := False;
end;

function TRacingStore.RevokeFamily(const AScope, AFamilyId: string; AAt: Int64): Integer;
begin
  Result := FInner.RevokeFamily(AScope, AFamilyId, AAt);
end;

function TRacingStore.RevokeUser(const AScope, AUserId: string; AAt: Int64): Integer;
begin
  Result := FInner.RevokeUser(AScope, AUserId, AAt);
end;

{ TRefreshTokensTests }

procedure TRefreshTokensTests.SetUp;
begin
  UseClock(T0);
  FStore := TMemoryRefreshTokenStore.Create;
  FTokens := TRefreshTokens.Create(FStore, 3600, Log);
  FLog := '';
  FActive := True;
end;

procedure TRefreshTokensTests.TearDown;
begin
  FTokens.Free;
  FStore := nil;
  TClock.Reset;
end;

procedure TRefreshTokensTests.Log(const ALine: string);
begin
  FLog := FLog + ALine + #10;
end;

function TRefreshTokensTests.UserActive(const AScope, AUserId: string): Boolean;
begin
  Result := FActive;
end;

// The rejection's name, or '' when Rotate accepted the token.
function TRefreshTokensTests.Rejection(const AToken: string): string;
begin
  Result := '';
  try
    FTokens.Rotate(AToken, UserActive);
  except
    on E: ERefreshTokenRejected do
      Result := RefreshRejectionName(E.Reason);
  end;
end;

procedure TRefreshTokensTests.Format_WithScope;
var
  LToken, LScope: string;
begin
  LToken := TRefreshTokens.NewToken('acme');
  TAssert.AssertEquals('acme.', Copy(LToken, 1, 5));
  TAssert.AssertEquals(5 + REFRESH_SECRET_CHARS, Length(LToken));
  TAssert.AssertTrue(TRefreshTokens.TryParse(LToken, LScope));
  TAssert.AssertEquals('acme', LScope);
  TAssert.AssertFalse('two tokens differ', LToken = TRefreshTokens.NewToken('acme'));
end;

procedure TRefreshTokensTests.Format_WithoutScope;
var
  LToken, LScope: string;
begin
  LToken := TRefreshTokens.NewToken('');
  TAssert.AssertEquals(REFRESH_SECRET_CHARS, Length(LToken));
  TAssert.AssertEquals(0, Pos('.', LToken));
  TAssert.AssertTrue(TRefreshTokens.TryParse(LToken, LScope));
  TAssert.AssertEquals('', LScope);
end;

procedure TRefreshTokensTests.Format_Refused;
var
  LScope, LSecret: string;
begin
  LSecret := Copy(TRefreshTokens.NewToken(''), 1, MaxInt);
  TAssert.AssertFalse('a dot and no scope', TRefreshTokens.TryParse('.' + LSecret, LScope));
  TAssert.AssertFalse('a short secret', TRefreshTokens.TryParse('acme.abc', LScope));
  TAssert.AssertFalse('a space in the scope', TRefreshTokens.TryParse('ac me.' + LSecret, LScope));
  TAssert.AssertFalse('a scope past 64', TRefreshTokens.TryParse(StringOfChar('a', 65) + '.' +
    LSecret, LScope));
  TAssert.AssertFalse('not Base64url', TRefreshTokens.TryParse('acme.' +
    StringOfChar('*', REFRESH_SECRET_CHARS), LScope));
  TAssert.AssertFalse('empty', TRefreshTokens.TryParse('', LScope));
  try
    TRefreshTokens.NewToken('a.b');
    TAssert.Fail('A scope with a dot must raise');
  except
    on E: EArgumentException do
      ;
  end;
end;

procedure TRefreshTokensTests.Hash_IsSha256Hex;
begin
  // FIPS 180-2's "abc"
  TAssert.AssertEquals('ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad',
    TRefreshTokens.Hash('abc'));
end;

procedure TRefreshTokensTests.Rotate_IssuesTheNextInTheFamily;
var
  LFirst: string;
  LNext: TRotatedRefreshToken;
  LRecord: TRefreshTokenRecord;
begin
  LFirst := FTokens.Issue('acme', 'u1');
  LNext := FTokens.Rotate(LFirst, UserActive);
  TAssert.AssertEquals('acme', LNext.Scope);
  TAssert.AssertEquals('u1', LNext.UserId);
  TAssert.AssertFalse(LNext.Token = LFirst);
  TAssert.AssertTrue(FStore.FindByHash('acme', TRefreshTokens.Hash(LNext.Token), LRecord));
  TAssert.AssertEquals('same family', LNext.FamilyId, LRecord.FamilyId);
  TAssert.AssertEquals(Int64(T0 + 3600), LRecord.ExpiresAt);
  TAssert.AssertEquals('the next rotates too', '', Rejection(LNext.Token));
  TAssert.AssertEquals('', FLog);
end;

procedure TRefreshTokensTests.Rotate_Reused_RevokesTheFamily;
var
  LFirst: string;
  LNext: TRotatedRefreshToken;
begin
  LFirst := FTokens.Issue('acme', 'u1');
  LNext := FTokens.Rotate(LFirst, UserActive);
  TAssert.AssertEquals('reused', Rejection(LFirst));
  TAssert.AssertEquals('the legitimate holder too', 'revoked', Rejection(LNext.Token));
  TAssert.AssertTrue(Pos('refresh token family ' + LNext.FamilyId +
    ' of scope acme revoked: a used refresh token came back', FLog) = 1);
end;

procedure TRefreshTokensTests.Rotate_Raced_RevokesTheFamily;
var
  LRacing: TRacingStore;
  LTokens: TRefreshTokens;
  LToken: string;
  LReason: string;
begin
  LRacing := TRacingStore.Create;
  LTokens := TRefreshTokens.Create(LRacing, 3600, Log);
  try
    LToken := LTokens.Issue('acme', 'u1');
    LRacing.LoseNextMark := True;
    LReason := '';
    try
      LTokens.Rotate(LToken, UserActive);
    except
      on E: ERefreshTokenRejected do
        LReason := RefreshRejectionName(E.Reason);
    end;
    TAssert.AssertEquals('raced', LReason);
    TAssert.AssertTrue(Pos('revoked: two refreshes raced on one token', FLog) > 0);
  finally
    LTokens.Free;
  end;
end;

// Found reading the unit for sample 01 (2026-10-19): the winner's MarkUsed, then
// the loser's revoke, then the winner's Add left the next token alive, and
// the winner was answered with it.
procedure TRefreshTokensTests.Rotate_Raced_LoserRevokedBeforeTheNextWasStored;
var
  LRacing: TRacingStore;
  LStore: IRefreshTokenStore;
  LTokens: TRefreshTokens;
  LToken, LReason: string;
  LRecord: TRefreshTokenRecord;
begin
  LRacing := TRacingStore.Create;
  LStore := LRacing;
  LTokens := TRefreshTokens.Create(LStore, 3600, Log);
  try
    LToken := LTokens.Issue('acme', 'u1');
    TAssert.AssertTrue(LStore.FindByHash('acme', TRefreshTokens.Hash(LToken), LRecord));
    LRacing.RevokeBeforeNextAdd := True;
    LReason := '';
    try
      LTokens.Rotate(LToken, UserActive);
    except
      on E: ERefreshTokenRejected do
        LReason := RefreshRejectionName(E.Reason);
    end;
    TAssert.AssertEquals('the winner is refused too', 'raced', LReason);
    TAssert.AssertEquals('no token of the family left unrevoked', 0,
      LStore.RevokeFamily('acme', LRecord.FamilyId, T0));
    TAssert.AssertTrue(Pos('revoked: two refreshes raced on one token', FLog) > 0);
  finally
    LTokens.Free;
  end;
end;

procedure TRefreshTokensTests.Rotate_UserGone_RevokesTheFamily;
var
  LToken: string;
begin
  LToken := FTokens.Issue('acme', 'u1');
  FActive := False;
  TAssert.AssertEquals('user_gone', Rejection(LToken));
  FActive := True;
  TAssert.AssertEquals('revoked', Rejection(LToken));
  TAssert.AssertTrue(Pos('revoked: the user is gone or inactive', FLog) > 0);
end;

procedure TRefreshTokensTests.Rotate_Expired;
var
  LToken: string;
begin
  LToken := FTokens.Issue('acme', 'u1');
  UseClock(T0 + 3599);
  LToken := FTokens.Rotate(LToken, UserActive).Token; // valid until T0 + 3600
  UseClock(T0 + 3599 + 3600);
  TAssert.AssertEquals('expired', Rejection(LToken));
  TAssert.AssertEquals('an expiry revokes nothing', '', FLog);
end;

procedure TRefreshTokensTests.Rotate_UnknownAndMalformed;
begin
  TAssert.AssertEquals('unknown', Rejection(TRefreshTokens.NewToken('acme')));
  TAssert.AssertEquals('malformed', Rejection('acme.nope'));
  TAssert.AssertEquals('malformed', Rejection(''));
end;

procedure TRefreshTokensTests.Rotate_AnotherScopeIsUnknown;
var
  LToken: string;
begin
  LToken := FTokens.Issue('acme', 'u1');
  // The same secret moved to another scope: its hash isn't stored there.
  TAssert.AssertEquals('unknown', Rejection('globex' + Copy(LToken, 5, MaxInt)));
end;

procedure TRefreshTokensTests.Revoke_EndsTheLogin_AnyTokenIsFine;
var
  LFirst: string;
  LNext: TRotatedRefreshToken;
begin
  LFirst := FTokens.Issue('acme', 'u1');
  LNext := FTokens.Rotate(LFirst, UserActive);
  FTokens.Revoke(LFirst); // an old token of the login ends it too
  TAssert.AssertEquals('revoked', Rejection(LNext.Token));
  FTokens.Revoke('garbage');
  FTokens.Revoke(TRefreshTokens.NewToken('acme'));
  TAssert.AssertEquals('a logout is not a security event', '', FLog);
end;

procedure TRefreshTokensTests.RevokeUser_EndsEveryLogin;
var
  A, B, C: string;
begin
  A := FTokens.Issue('acme', 'u1');
  B := FTokens.Issue('acme', 'u1');
  C := FTokens.Issue('acme', 'u2');
  TAssert.AssertEquals(2, FTokens.RevokeUser('acme', 'u1'));
  TAssert.AssertEquals('revoked', Rejection(A));
  TAssert.AssertEquals('revoked', Rejection(B));
  TAssert.AssertEquals('another user keeps theirs', '', Rejection(C));
  TAssert.AssertEquals(0, FTokens.RevokeUser('acme', 'u1'));
end;

procedure TRefreshTokensTests.Security_WithoutScope;
var
  LFirst: string;
begin
  LFirst := FTokens.Issue('', 'u1');
  FTokens.Rotate(LFirst, UserActive);
  TAssert.AssertEquals('reused', Rejection(LFirst));
  // No "of scope " with nothing after it.
  TAssert.AssertEquals(0, Pos('scope', FLog));
  TAssert.AssertTrue(Pos(' revoked: a used refresh token came back', FLog) > 0);
end;

procedure TRefreshTokensTests.DbStore_SqlAndParameters;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LStore: IRefreshTokenStore;
  LRecord: TRefreshTokenRecord;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LStore := TDbRefreshTokenStore.Create(LFactory);
  LRecord.Id := 'id1';
  LRecord.UserId := 'u1';
  LRecord.FamilyId := 'f1';
  LRecord.ExpiresAt := T0 + 60;
  LRecord.Used := False;
  LRecord.Revoked := False;
  LStore.Add('acme', 'h1', LRecord, T0);
  TAssert.AssertEquals('acme', LMock.LastExecution('REFRESH.INSERT').AsString('TENANT_ID'));
  TAssert.AssertEquals('h1', LMock.LastExecution('REFRESH.INSERT').AsString('TOKEN_HASH'));
  TAssert.AssertEquals('f1', LMock.LastExecution('REFRESH.INSERT').AsString('FAMILY_ID'));
  TAssert.AssertEquals(Int64(T0 + 60), LMock.LastExecution('REFRESH.INSERT').AsInt64('EXPIRES_AT'));

  LMock.AddResult('REFRESH.BY_HASH', TMockQueryResult.SingleRow(
    ['ID', 'USER_ID', 'FAMILY_ID', 'EXPIRES_AT', 'USED_AT', 'REVOKED_AT'],
    ['id1', 'u1', 'f1', T0 + 60, T0 + 5, Null]));
  TAssert.AssertTrue(LStore.FindByHash('acme', 'h1', LRecord));
  TAssert.AssertEquals('f1', LRecord.FamilyId);
  TAssert.AssertTrue('USED_AT set', LRecord.Used);
  TAssert.AssertFalse('REVOKED_AT null', LRecord.Revoked);

  LMock.SetRowsAffected('REFRESH.MARK_USED', 1);
  TAssert.AssertTrue('one row: this call marked it', LStore.MarkUsed('acme', 'id1', T0));
  LMock.SetRowsAffected('REFRESH.MARK_USED', 0);
  TAssert.AssertFalse('no row: another call did', LStore.MarkUsed('acme', 'id1', T0));
  LMock.SetRowsAffected('REFRESH.REVOKE_FAMILY', 3);
  TAssert.AssertEquals(3, LStore.RevokeFamily('acme', 'f1', T0));
  TAssert.AssertEquals('f1', LMock.LastExecution('REFRESH.REVOKE_FAMILY').AsString('FAMILY_ID'));
  LStore.RevokeUser('acme', 'u1', T0);
  TAssert.AssertEquals('u1', LMock.LastExecution('REFRESH.REVOKE_USER').AsString('USER_ID'));
end;

// The rotation in one hold of the store (0.20.1): the first call marks the
// token and stores the next; a second call for the same token stores nothing.
procedure TRefreshTokensTests.MemoryStore_MarkUsedAndAdd_OnlyTheFirst;
var
  LMemory: TMemoryRefreshTokenStore;
  LStore: IRefreshTokenStore;
  LAtomic: IRefreshTokenAtomicRotation;
  LFirst, LNext: TRefreshTokenRecord;
begin
  LMemory := TMemoryRefreshTokenStore.Create;
  LStore := LMemory;
  TAssert.AssertTrue('the memory store has the atomic rotation',
    Supports(LStore, IRefreshTokenAtomicRotation, LAtomic));
  LFirst.Id := 'id1';
  LFirst.UserId := 'u1';
  LFirst.FamilyId := 'f1';
  LFirst.ExpiresAt := T0 + 60;
  LFirst.Used := False;
  LFirst.Revoked := False;
  LStore.Add('acme', 'h1', LFirst, T0);
  LNext := LFirst;
  LNext.Id := 'id2';
  TAssert.AssertTrue('the first marks and stores', LAtomic.MarkUsedAndAdd('acme', 'id1', T0, 'h2', LNext));
  LNext.Id := 'id3';
  TAssert.AssertFalse('the second finds it used', LAtomic.MarkUsedAndAdd('acme', 'id1', T0, 'h3', LNext));
  TAssert.AssertEquals('nothing stored by the second', 2, LMemory.Count);
end;

procedure TRefreshTokensTests.DbStore_MarkUsedAndAdd_InsertsOnlyWhenMarked;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LStore: IRefreshTokenStore;
  LAtomic: IRefreshTokenAtomicRotation;
  LNext: TRefreshTokenRecord;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LStore := TDbRefreshTokenStore.Create(LFactory);
  TAssert.AssertTrue('the database store has the atomic rotation',
    Supports(LStore, IRefreshTokenAtomicRotation, LAtomic));
  LNext.Id := 'id2';
  LNext.UserId := 'u1';
  LNext.FamilyId := 'f1';
  LNext.ExpiresAt := T0 + 60;
  LNext.Used := False;
  LNext.Revoked := False;
  LMock.SetRowsAffected('REFRESH.MARK_USED', 0);
  TAssert.AssertFalse('no row marked: another request did',
    LAtomic.MarkUsedAndAdd('acme', 'id1', T0, 'h2', LNext));
  TAssert.AssertEquals('then no insert', 0, LMock.ExecutionCount('REFRESH.INSERT'));
  LMock.SetRowsAffected('REFRESH.MARK_USED', 1);
  TAssert.AssertTrue('one row marked', LAtomic.MarkUsedAndAdd('acme', 'id1', T0, 'h2', LNext));
  TAssert.AssertEquals('id1', LMock.LastExecution('REFRESH.MARK_USED').AsString('ID'));
  TAssert.AssertEquals('h2', LMock.LastExecution('REFRESH.INSERT').AsString('TOKEN_HASH'));
  TAssert.AssertEquals('id2', LMock.LastExecution('REFRESH.INSERT').AsString('ID'));
end;

initialization
  RegisterTest(TRefreshTokensTests);

end.
