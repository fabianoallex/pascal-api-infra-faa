unit PascalApi.TenancyTests;

(* Tests for PascalApi.Tenancy: the configuration catalog (modes, suspended,
  every rejected spec), CheckTenant, the tenant claim, the refusals (status,
  body, messages in Portuguese), the database key and pool name, the
  resolver (one factory per database, shared tenants on one, idle databases
  dropped) and TTenantFilter.Prepare.

  Databases are pascal-db-faa's TMockDBFactory: its SqlLoader returns the
  resource name as the SQL, so a test passes the SQL itself as the "name",
  and LastExecution shows what was bound. Time is a manual ticker installed
  in TTicker: no real waits.

  The HTTP side (the middleware, a token of one tenant on another's rows) is
  tools/http_scenarios_tenants.sh against samples/03-tenants.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand.

  This comment uses parenthesis-asterisk: the tests quote ${TENANT}. *)

interface

uses
  DUnitX.TestFramework,
  PascalApi.DUnitXCompat,
  SysUtils,
  Variants,
  PascalCommon.SystemContext,
  PascalJsonMapper.Json,
  PascalDb.Interfaces,
  PascalDb.Mock,
  PascalApi.Http,
  PascalApi.Tenancy;

type
  TManualTicker = class(TInterfacedObject, ITicker)
  private
    FNowMs: UInt64;
  public
    procedure Advance(AMs: UInt64);
    function NowMs: UInt64;
  end;

  /// Another catalog, its calls counted; Inner can be swapped to change the
  /// answers.
  TCountingCatalog = class(TInterfacedObject, ITenantCatalog)
  public
    Inner: ITenantCatalog;
    Finds, Alls: Integer;
    function Find(const AId: string; out AInfo: TTenantInfo): Boolean;
    function All: TArray<TTenantInfo>;
  end;

  /// The resolver's callback: a new mock per call, counted.
  TFactoryMaker = class
  public
    Calls: Integer;
    LastKey, LastPool: string;
    function NewFactory(const ADatabaseKey, APoolName: string): IDBFactory;
  end;

  [TestFixture]
  TTenancyTests = class
  private
    FTicker: TManualTicker;
    FTickerRef: ITicker;
    FMaker: TFactoryMaker;
    function Catalog: ITenantCatalog;
    function Info(const AId: string): TTenantInfo;
    function CatalogError(const ASpec: string): string;
    function DbCatalogError(const AMode, AId: string): string;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;

    [Test] procedure Catalog_ReadsModesAndSuspended;
    [Test] procedure Catalog_IgnoresSpacesAndEmptyEntries;
    [Test] procedure Catalog_FindIsExact;
    [Test] procedure Catalog_AllIsACopy;
    [Test] procedure Catalog_RejectsAnEntryWithoutEquals;
    [Test] procedure Catalog_RejectsAnInvalidId;
    [Test] procedure Catalog_RejectsARepeatedId;
    [Test] procedure Catalog_RejectsAnEntryWithoutMode;
    [Test] procedure Catalog_RejectsAnUnknownOption;
    [Test] procedure Catalog_ReadsAPlan;
    [Test] procedure Catalog_RejectsAnInvalidPlan;
    [Test] procedure DbCatalog_Find_ReadsTheRow;
    [Test] procedure DbCatalog_Find_NullPlanAndSuspended;
    [Test] procedure DbCatalog_Find_Unknown;
    [Test] procedure DbCatalog_Find_AnImpossibleIdNeverQueries;
    [Test] procedure DbCatalog_RejectsABadRow;
    [Test] procedure DbCatalog_All_ReadsEveryRow;
    [Test] procedure Cached_FoundTenant_KeptForTheTtl;
    [Test] procedure Cached_Change_SeenAfterTheTtl;
    [Test] procedure Cached_UnknownTenant_NotKept;
    [Test] procedure Cached_Invalidate_AsksAgain;
    [Test] procedure Cached_All_KeptAndInvalidated;
    [Test] procedure CheckTenant_EachOutcome;
    [Test] procedure TenantIdFromClaims_OnlyAStringClaim;
    [Test] procedure Rejection_NoTenantAndUnknown_Are401;
    [Test] procedure Rejection_Suspended_Is403WithCode;
    [Test] procedure Rejection_Ok_IsEmpty;
    [Test] procedure Rejection_FollowsTheMessages;
    [Test] procedure DatabaseKeyAndPoolName_ByMode;
    [Test] procedure Resolver_OneFactoryPerDatabase;
    [Test] procedure Resolver_SharedTenantsShareOneDatabase;
    [Test] procedure Resolver_PassesKeyAndPoolName;
    [Test] procedure Resolver_NoIdleTime_KeepsEveryDatabase;
    [Test] procedure Resolver_IdleDatabase_IsDropped;
    [Test] procedure Resolver_RecentlyUsedDatabase_IsKept;
    [Test] procedure Filter_Condition_WithAndWithoutAlias;
    [Test] procedure Filter_Prepare_ReplacesAndBinds;
  end;

implementation

const
  SPEC = 'acme=dedicated;globex=dedicated;initech=shared;umbrella=shared;soylent=shared,suspended';

{ TManualTicker }

procedure TManualTicker.Advance(AMs: UInt64);
begin
  Inc(FNowMs, AMs);
end;

function TManualTicker.NowMs: UInt64;
begin
  Result := FNowMs;
end;

{ TCountingCatalog }

function TCountingCatalog.Find(const AId: string; out AInfo: TTenantInfo): Boolean;
begin
  Inc(Finds);
  Result := Inner.Find(AId, AInfo);
end;

function TCountingCatalog.All: TArray<TTenantInfo>;
begin
  Inc(Alls);
  Result := Inner.All;
end;

{ TFactoryMaker }

function TFactoryMaker.NewFactory(const ADatabaseKey, APoolName: string): IDBFactory;
begin
  Inc(Calls);
  LastKey := ADatabaseKey;
  LastPool := APoolName;
  Result := TMockDBFactory.Create;
end;

{ TTenancyTests }

procedure TTenancyTests.Setup;
begin
  FTicker := TManualTicker.Create;
  FTicker.FNowMs := 1000000;
  FTickerRef := FTicker;
  TTicker.SetTicker(FTickerRef);
  FMaker := TFactoryMaker.Create;
  TApiMessages.Current := TApiMessages.English;
end;

procedure TTenancyTests.TearDown;
begin
  TTicker.Reset;
  FTickerRef := nil;
  FMaker.Free;
  TApiMessages.Current := TApiMessages.English;
end;

function TTenancyTests.Catalog: ITenantCatalog;
begin
  Result := TConfigTenantCatalog.Create(SPEC);
end;

function TTenancyTests.Info(const AId: string): TTenantInfo;
begin
  TAssert.AssertTrue('Precondition: ' + AId + ' in the catalog', Catalog.Find(AId, Result));
end;

function TTenancyTests.CatalogError(const ASpec: string): string;
var
  LCatalog: ITenantCatalog;
begin
  Result := '';
  try
    LCatalog := TConfigTenantCatalog.Create(ASpec);
  except
    on E: ETenantCatalogError do
      Result := E.Message;
  end;
end;

procedure TTenancyTests.Catalog_ReadsModesAndSuspended;
var
  LInfo: TTenantInfo;
begin
  TAssert.AssertEquals('five tenants', 5, Length(Catalog.All));
  LInfo := Info('acme');
  TAssert.AssertTrue('acme dedicated', LInfo.Mode = tmDedicated);
  TAssert.AssertFalse('acme active', LInfo.Suspended);
  LInfo := Info('initech');
  TAssert.AssertTrue('initech shared', LInfo.Mode = tmShared);
  LInfo := Info('soylent');
  TAssert.AssertTrue('soylent shared', LInfo.Mode = tmShared);
  TAssert.AssertTrue('soylent suspended', LInfo.Suspended);
end;

procedure TTenancyTests.Catalog_IgnoresSpacesAndEmptyEntries;
var
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LCatalog := TConfigTenantCatalog.Create(' acme = Dedicated ;; initech=shared , suspended ; ');
  TAssert.AssertEquals(2, Length(LCatalog.All));
  TAssert.AssertTrue(LCatalog.Find('acme', LInfo));
  TAssert.AssertTrue('mode is case-insensitive', LInfo.Mode = tmDedicated);
  TAssert.AssertTrue(LCatalog.Find('initech', LInfo));
  TAssert.AssertTrue(LInfo.Suspended);
  LCatalog := TConfigTenantCatalog.Create('');
  TAssert.AssertEquals('an empty spec is an empty catalog', 0, Length(LCatalog.All));
end;

procedure TTenancyTests.Catalog_FindIsExact;
var
  LInfo: TTenantInfo;
begin
  TAssert.AssertFalse('case matters', Catalog.Find('ACME', LInfo));
  TAssert.AssertFalse('no prefix match', Catalog.Find('acm', LInfo));
  TAssert.AssertEquals('not found leaves no id', '', LInfo.Id);
end;

procedure TTenancyTests.Catalog_AllIsACopy;
var
  LCatalog: ITenantCatalog;
  LAll: TArray<TTenantInfo>;
  LInfo: TTenantInfo;
begin
  LCatalog := Catalog;
  LAll := LCatalog.All;
  LAll[0].Id := 'changed';
  TAssert.AssertTrue(LCatalog.Find('acme', LInfo));
  TAssert.AssertFalse(LCatalog.Find('changed', LInfo));
end;

procedure TTenancyTests.Catalog_RejectsAnEntryWithoutEquals;
begin
  TAssert.AssertEquals('Tenant entry "acme" has no "=".', CatalogError('acme'));
end;

procedure TTenancyTests.Catalog_RejectsAnInvalidId;
begin
  TAssert.AssertEquals('Invalid tenant id "Acme": 1 to 40 of a-z, 0-9 and "-".',
    CatalogError('Acme=shared'));
  TAssert.AssertTrue('a path in the id', CatalogError('../x=shared') <> '');
  TAssert.AssertTrue('empty id', CatalogError('=shared') <> '');
  TAssert.AssertTrue('41 characters', CatalogError(StringOfChar('a', 41) + '=shared') <> '');
  TAssert.AssertEquals('40 characters', '', CatalogError(StringOfChar('a', 40) + '=shared'));
end;

procedure TTenancyTests.Catalog_RejectsARepeatedId;
begin
  TAssert.AssertEquals('Tenant "acme" appears twice.', CatalogError('acme=shared;acme=dedicated'));
end;

procedure TTenancyTests.Catalog_RejectsAnEntryWithoutMode;
begin
  TAssert.AssertEquals('Tenant "acme": dedicated or shared?', CatalogError('acme=suspended'));
end;

procedure TTenancyTests.Catalog_RejectsAnUnknownOption;
begin
  TAssert.AssertEquals('Tenant "acme": unknown option "shard".', CatalogError('acme=shared,shard'));
end;

procedure TTenancyTests.Catalog_ReadsAPlan;
var
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LCatalog := TConfigTenantCatalog.Create('acme=dedicated,plan:Gold;initech=shared');
  TAssert.AssertTrue(LCatalog.Find('acme', LInfo));
  TAssert.AssertEquals('lowercase, as every option', 'gold', LInfo.Plan);
  TAssert.AssertTrue(LCatalog.Find('initech', LInfo));
  TAssert.AssertEquals('no plan', '', LInfo.Plan);
end;

procedure TTenancyTests.Catalog_RejectsAnInvalidPlan;
begin
  TAssert.AssertEquals('Tenant "acme": invalid plan "".', CatalogError('acme=shared,plan:'));
  TAssert.AssertEquals('Tenant "acme": invalid plan "g/1".', CatalogError('acme=shared,plan:g/1'));
end;

function TTenancyTests.DbCatalogError(const AMode, AId: string): string;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  Result := '';
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  LMock.AddResult('TENANT.BY_ID', TMockQueryResult.SingleRow(['ID', 'MODE', 'SUSPENDED', 'PLAN'],
    [AId, AMode, 0, Null]));
  try
    LCatalog.Find('acme', LInfo);
  except
    on E: ETenantCatalogError do
      Result := E.Message;
  end;
end;

procedure TTenancyTests.DbCatalog_Find_ReadsTheRow;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  LMock.AddResult('TENANT.BY_ID', TMockQueryResult.SingleRow(['ID', 'MODE', 'SUSPENDED', 'PLAN'],
    ['acme', 'dedicated', 0, 'gold']));
  TAssert.AssertTrue(LCatalog.Find('acme', LInfo));
  TAssert.AssertEquals('the id is the parameter', 'acme',
    LMock.LastExecution('TENANT.BY_ID').AsString('ID'));
  TAssert.AssertEquals('acme', LInfo.Id);
  TAssert.AssertTrue('dedicated', LInfo.Mode = tmDedicated);
  TAssert.AssertFalse(LInfo.Suspended);
  TAssert.AssertEquals('gold', LInfo.Plan);
end;

procedure TTenancyTests.DbCatalog_Find_NullPlanAndSuspended;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  LMock.AddResult('TENANT.BY_ID', TMockQueryResult.SingleRow(['ID', 'MODE', 'SUSPENDED', 'PLAN'],
    ['soylent', ' Shared ', 1, Null]));
  TAssert.AssertTrue(LCatalog.Find('soylent', LInfo));
  TAssert.AssertTrue('mode trimmed, any case', LInfo.Mode = tmShared);
  TAssert.AssertTrue(LInfo.Suspended);
  TAssert.AssertEquals('NULL is no plan', '', LInfo.Plan);
end;

procedure TTenancyTests.DbCatalog_Find_Unknown;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  LMock.AddResult('TENANT.BY_ID', TMockQueryResult.Empty);
  TAssert.AssertFalse(LCatalog.Find('wayne', LInfo));
  TAssert.AssertEquals('', LInfo.Id);
end;

procedure TTenancyTests.DbCatalog_Find_AnImpossibleIdNeverQueries;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  TAssert.AssertFalse(LCatalog.Find('../etc', LInfo));
  TAssert.AssertFalse(LCatalog.Find('', LInfo));
  TAssert.AssertEquals(0, LMock.ExecutionCount('TENANT.BY_ID'));
end;

procedure TTenancyTests.DbCatalog_RejectsABadRow;
begin
  TAssert.AssertEquals('Tenant "acme": mode "sharded" in the catalog.', DbCatalogError('sharded', 'acme'));
  TAssert.AssertEquals('Invalid tenant id "Acme" in the catalog.', DbCatalogError('shared', 'Acme'));
end;

procedure TTenancyTests.DbCatalog_All_ReadsEveryRow;
var
  LMock: TMockDBFactory;
  LCatalog: ITenantCatalog;
  LAll: TArray<TTenantInfo>;
begin
  LMock := TMockDBFactory.Create;
  LCatalog := TDbTenantCatalog.Create(LMock);
  LMock.AddResult('TENANT.ALL', TMockQueryResult.MultiRows(['ID', 'MODE', 'SUSPENDED', 'PLAN'],
    [TArray<Variant>.Create('acme', 'dedicated', 0, 'gold'),
     TArray<Variant>.Create('initech', 'shared', 0, Null)]));
  LAll := LCatalog.All;
  TAssert.AssertEquals(2, Length(LAll));
  TAssert.AssertEquals('acme', LAll[0].Id);
  TAssert.AssertEquals('initech', LAll[1].Id);
  TAssert.AssertTrue(LAll[1].Mode = tmShared);
end;

procedure TTenancyTests.Cached_FoundTenant_KeptForTheTtl;
var
  LInner: TCountingCatalog;
  LCached: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LInner := TCountingCatalog.Create;
  LInner.Inner := Catalog;
  LCached := TCachedTenantCatalog.Create(LInner, 30);
  TAssert.AssertTrue(LCached.Find('acme', LInfo));
  FTicker.Advance(29 * 1000);
  TAssert.AssertTrue(LCached.Find('acme', LInfo));
  TAssert.AssertEquals('asked once within the TTL', 1, LInner.Finds);
  FTicker.Advance(1000);
  TAssert.AssertTrue(LCached.Find('acme', LInfo));
  TAssert.AssertEquals('asked again after it', 2, LInner.Finds);
end;

procedure TTenancyTests.Cached_Change_SeenAfterTheTtl;
var
  LInner: TCountingCatalog;
  LCached: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LInner := TCountingCatalog.Create;
  LInner.Inner := TConfigTenantCatalog.Create('acme=dedicated');
  LCached := TCachedTenantCatalog.Create(LInner, 30);
  LCached.Find('acme', LInfo);
  LInner.Inner := TConfigTenantCatalog.Create('acme=dedicated,suspended');
  LCached.Find('acme', LInfo);
  TAssert.AssertFalse('the cached answer within the TTL', LInfo.Suspended);
  FTicker.Advance(30 * 1000);
  LCached.Find('acme', LInfo);
  TAssert.AssertTrue('the change after it', LInfo.Suspended);
end;

procedure TTenancyTests.Cached_UnknownTenant_NotKept;
var
  LInner: TCountingCatalog;
  LCached: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LInner := TCountingCatalog.Create;
  LInner.Inner := Catalog;
  LCached := TCachedTenantCatalog.Create(LInner, 30);
  TAssert.AssertFalse(LCached.Find('wayne', LInfo));
  TAssert.AssertFalse(LCached.Find('wayne', LInfo));
  TAssert.AssertEquals('every miss asks', 2, LInner.Finds);
  LInner.Inner := TConfigTenantCatalog.Create(SPEC + ';wayne=shared');
  TAssert.AssertTrue('a tenant just provisioned is seen at once', LCached.Find('wayne', LInfo));
end;

procedure TTenancyTests.Cached_Invalidate_AsksAgain;
var
  LInner: TCountingCatalog;
  LCached: TCachedTenantCatalog;
  LRef: ITenantCatalog;
  LInfo: TTenantInfo;
begin
  LInner := TCountingCatalog.Create;
  LInner.Inner := Catalog;
  LCached := TCachedTenantCatalog.Create(LInner, 30);
  LRef := LCached;
  LCached.Find('acme', LInfo);
  LCached.Find('globex', LInfo);
  LCached.Invalidate('acme');
  LCached.Find('acme', LInfo);
  LCached.Find('globex', LInfo);
  TAssert.AssertEquals('acme again, globex still kept', 3, LInner.Finds);
  LCached.InvalidateAll;
  LCached.Find('globex', LInfo);
  TAssert.AssertEquals(4, LInner.Finds);
end;

procedure TTenancyTests.Cached_All_KeptAndInvalidated;
var
  LInner: TCountingCatalog;
  LCached: TCachedTenantCatalog;
  LRef: ITenantCatalog;
begin
  LInner := TCountingCatalog.Create;
  LInner.Inner := Catalog;
  LCached := TCachedTenantCatalog.Create(LInner, 30);
  LRef := LCached;
  TAssert.AssertEquals(5, Length(LCached.All));
  TAssert.AssertEquals(5, Length(LCached.All));
  TAssert.AssertEquals('kept', 1, LInner.Alls);
  LCached.Invalidate('acme');
  LCached.All;
  TAssert.AssertEquals('a change to one tenant also drops the list', 2, LInner.Alls);
  FTicker.Advance(30 * 1000);
  LCached.All;
  TAssert.AssertEquals('and so does the TTL', 3, LInner.Alls);
end;

procedure TTenancyTests.CheckTenant_EachOutcome;
var
  LInfo: TTenantInfo;
begin
  TAssert.AssertTrue('empty', CheckTenant(Catalog, '', LInfo) = tcNoTenant);
  TAssert.AssertTrue('unknown', CheckTenant(Catalog, 'wayne', LInfo) = tcUnknown);
  TAssert.AssertTrue('suspended', CheckTenant(Catalog, 'soylent', LInfo) = tcSuspended);
  TAssert.AssertTrue('ok', CheckTenant(Catalog, 'globex', LInfo) = tcOk);
  TAssert.AssertEquals('ok fills the info', 'globex', LInfo.Id);
end;

procedure TTenancyTests.TenantIdFromClaims_OnlyAStringClaim;

  function IdOf(const AJson, AClaim: string): string;
  var
    LClaims: TJsonValue;
  begin
    LClaims := ParseJson(AJson);
    try
      Result := TenantIdFromClaims(LClaims, AClaim);
    finally
      LClaims.Free;
    end;
  end;

begin
  TAssert.AssertEquals('acme', IdOf('{"sub":"ana","tenant_id":"acme"}', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('another claim name', 'acme', IdOf('{"org":"acme"}', 'org'));
  TAssert.AssertEquals('absent', '', IdOf('{"sub":"ana"}', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('tid is not tenant_id', '', IdOf('{"tid":"acme"}', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('a number', '', IdOf('{"tenant_id":7}', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('an array', '', IdOf('{"tenant_id":["acme"]}', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('not an object', '', IdOf('["acme"]', TENANT_DEFAULT_CLAIM));
  TAssert.AssertEquals('no claims', '', TenantIdFromClaims(nil, TENANT_DEFAULT_CLAIM));
end;

procedure TTenancyTests.Rejection_NoTenantAndUnknown_Are401;
var
  LStatus: Integer;
begin
  TAssert.AssertEquals('{"error":"The token names no tenant."}', TenantRejection(tcNoTenant, LStatus));
  TAssert.AssertEquals(401, LStatus);
  TAssert.AssertEquals('{"error":"The token''s tenant no longer exists."}',
    TenantRejection(tcUnknown, LStatus));
  TAssert.AssertEquals(401, LStatus);
end;

procedure TTenancyTests.Rejection_Suspended_Is403WithCode;
var
  LStatus: Integer;
begin
  TAssert.AssertEquals('{"error":"This tenant is suspended.","code":"tenant_suspended"}',
    TenantRejection(tcSuspended, LStatus));
  TAssert.AssertEquals(403, LStatus);
end;

procedure TTenancyTests.Rejection_Ok_IsEmpty;
var
  LStatus: Integer;
begin
  TAssert.AssertEquals('', TenantRejection(tcOk, LStatus));
  TAssert.AssertEquals(0, LStatus);
end;

procedure TTenancyTests.Rejection_FollowsTheMessages;
var
  LStatus: Integer;
begin
  TApiMessages.Current := TApiMessages.Portuguese;
  TAssert.AssertEquals('{"error":"Este tenant está suspenso.","code":"tenant_suspended"}',
    TenantRejection(tcSuspended, LStatus));
  TAssert.AssertEquals('{"error":"O tenant do token não existe mais."}',
    TenantRejection(tcUnknown, LStatus));
end;

procedure TTenancyTests.DatabaseKeyAndPoolName_ByMode;
begin
  TAssert.AssertEquals('tenant_acme', DatabaseKeyOf(Info('acme')));
  TAssert.AssertEquals('dedicated', PoolNameOf(Info('acme')));
  TAssert.AssertEquals('shared', DatabaseKeyOf(Info('initech')));
  TAssert.AssertEquals('shared', PoolNameOf(Info('initech')));
end;

procedure TTenancyTests.Resolver_OneFactoryPerDatabase;
var
  LResolver: ITenantDataResolver;
  LFirst, LSecond, LOther: TTenantDataScope;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory);
  LFirst := LResolver.ScopeFor(Info('acme'));
  LSecond := LResolver.ScopeFor(Info('acme'));
  LOther := LResolver.ScopeFor(Info('globex'));
  TAssert.AssertEquals('two databases', 2, FMaker.Calls);
  TAssert.AssertTrue('the same factory again', LFirst.Factory = LSecond.Factory);
  TAssert.AssertTrue('another tenant, another factory', LFirst.Factory <> LOther.Factory);
  TAssert.AssertEquals('acme', LFirst.Discriminator);
  TAssert.AssertEquals('globex', LOther.Discriminator);
end;

procedure TTenancyTests.Resolver_SharedTenantsShareOneDatabase;
var
  LResolver: ITenantDataResolver;
  LInitech, LUmbrella: TTenantDataScope;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory);
  LInitech := LResolver.ScopeFor(Info('initech'));
  LUmbrella := LResolver.ScopeFor(Info('umbrella'));
  TAssert.AssertEquals('one database', 1, FMaker.Calls);
  TAssert.AssertTrue('one factory', LInitech.Factory = LUmbrella.Factory);
  TAssert.AssertEquals('each its own filter', 'initech', LInitech.Discriminator);
  TAssert.AssertEquals('each its own filter', 'umbrella', LUmbrella.Discriminator);
end;

procedure TTenancyTests.Resolver_PassesKeyAndPoolName;
var
  LResolver: ITenantDataResolver;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory);
  LResolver.ScopeFor(Info('globex'));
  TAssert.AssertEquals('tenant_globex', FMaker.LastKey);
  TAssert.AssertEquals('dedicated', FMaker.LastPool);
  LResolver.ScopeFor(Info('umbrella'));
  TAssert.AssertEquals('shared', FMaker.LastKey);
  TAssert.AssertEquals('shared', FMaker.LastPool);
end;

procedure TTenancyTests.Resolver_NoIdleTime_KeepsEveryDatabase;
var
  LResolver: TTenantDataResolver;
  LRef: ITenantDataResolver;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory);
  LRef := LResolver;
  LResolver.ScopeFor(Info('acme'));
  LResolver.ScopeFor(Info('initech'));
  FTicker.Advance(3600 * 1000);
  LResolver.ScopeFor(Info('initech'));
  TAssert.AssertEquals(2, LResolver.DatabaseCount);
  LResolver.ScopeFor(Info('acme'));
  TAssert.AssertEquals('nothing created again', 2, FMaker.Calls);
end;

procedure TTenancyTests.Resolver_IdleDatabase_IsDropped;
var
  LResolver: TTenantDataResolver;
  LRef: ITenantDataResolver;
  LHeld: TTenantDataScope;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory, 60);
  LRef := LResolver;
  LHeld := LResolver.ScopeFor(Info('acme'));
  LResolver.ScopeFor(Info('initech'));
  FTicker.Advance(61 * 1000);
  LResolver.ScopeFor(Info('initech'));
  TAssert.AssertEquals('acme dropped, initech kept', 1, LResolver.DatabaseCount);
  TAssert.AssertTrue('a scope still held keeps its factory', LHeld.Factory <> nil);
  LResolver.ScopeFor(Info('acme'));
  TAssert.AssertEquals('acme created again', 3, FMaker.Calls);
end;

procedure TTenancyTests.Resolver_RecentlyUsedDatabase_IsKept;
var
  LResolver: TTenantDataResolver;
  LRef: ITenantDataResolver;
begin
  LResolver := TTenantDataResolver.Create(FMaker.NewFactory, 60);
  LRef := LResolver;
  LResolver.ScopeFor(Info('acme'));
  LResolver.ScopeFor(Info('initech'));
  FTicker.Advance(40 * 1000);
  LResolver.ScopeFor(Info('acme'));
  FTicker.Advance(40 * 1000);
  // initech idle 80 s, acme 40 s.
  LResolver.ScopeFor(Info('globex'));
  TAssert.AssertEquals('acme and globex', 2, LResolver.DatabaseCount);
  LResolver.ScopeFor(Info('acme'));
  TAssert.AssertEquals('acme was not created again', 3, FMaker.Calls);
end;

procedure TTenancyTests.Filter_Condition_WithAndWithoutAlias;
begin
  TAssert.AssertEquals('TENANT_ID = :TENANT_ID', TTenantFilter.Condition);
  TAssert.AssertEquals('c.TENANT_ID = :TENANT_ID', TTenantFilter.Condition('c'));
end;

procedure TTenancyTests.Filter_Prepare_ReplacesAndBinds;
const
  SQL = 'DELETE FROM CITIES WHERE CODE = :CODE AND ${TENANT}';
  EXPECTED = 'DELETE FROM CITIES WHERE CODE = :CODE AND TENANT_ID = :TENANT_ID';
var
  LMock: TMockDBFactory;
  LScope: TTenantDataScope;
  LQuery: IQuery;
  LTransaction: IScopeTransaction;
begin
  LMock := TMockDBFactory.Create;
  LScope.Factory := LMock;
  LScope.Discriminator := 'initech';
  LTransaction := LScope.Factory.GetPool.AcquireQuery(LQuery);
  TTenantFilter.Prepare(LQuery, LScope, SQL);
  LQuery.Params.Strings['CODE'] := '4314902';
  TAssert.AssertEquals(EXPECTED, LQuery.Sql);
  LQuery.ExecSql;
  TAssert.AssertEquals('bound in the same call', 'initech',
    LMock.LastExecution(EXPECTED).AsString('TENANT_ID'));
  TAssert.AssertEquals('4314902', LMock.LastExecution(EXPECTED).AsString('CODE'));
end;

initialization
  TDUnitX.RegisterTestFixture(TTenancyTests);

end.
