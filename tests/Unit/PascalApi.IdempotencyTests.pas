unit PascalApi.IdempotencyTests;

{ Tests for PascalApi.Idempotency: the key, the fingerprint, the stored
  headers, the policy over the memory store (claim, in flight, replay,
  another request, a lease that ran out, expiry, scopes, a failure stored
  or released) and TDbIdempotencyStore's SQL and parameters on
  pascal-db-faa's mock.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. The file is UTF-8
  with a BOM (non-ASCII test data, in typed constants). }

interface

uses
  DUnitX.TestFramework,
  PascalApi.DUnitXCompat,
  SysUtils,
  Variants,
  PascalDb.Interfaces,
  PascalDb.Mock,
  PascalApi.Http,
  PascalApi.Idempotency;

type
  [TestFixture]
  TIdempotencyTests = class
  public
    [Test] procedure Key_BareOrQuoted;
    [Test] procedure Key_Refused;
    [Test] procedure Fingerprint_Sha256OfUtf8;
    [Test] procedure HeaderLines_RoundTrip;
    [Test] procedure HeaderLines_LineBreakRefused;
    [Test] procedure Claim_ThenInFlight_ThenReplay;
    [Test] procedure Claim_OtherRequest_Is422;
    [Test] procedure Claim_LeaseRanOut_TakenOver;
    [Test] procedure Claim_Expired_IsNew;
    [Test] procedure Claim_ScopesAreApart;
    [Test] procedure Fail_ClientErrorStored_OtherReleased;
    [Test] procedure Start_InvalidKey_Is400;
    [Test] procedure DbStore_SqlAndParameters;
  end;

implementation

const
  T0 = 1800000000;
  NON_ASCII_KEY: string = 'ação';
  NON_ASCII_BODY: string = '{"a":"ção"}';
  BY_KEY_FIELDS: array[0..5] of string = ('FINGERPRINT', 'DONE', 'LEASE_UNTIL', 'STATUS_CODE',
    'RESPONSE_HEADERS', 'RESPONSE_BODY');

// Start's outcome as text: 'run', 'replay <status> <body>' or '<status> <code>'.
function Outcome(AIdem: TIdempotency; const AScope, AKey, AFingerprint: string;
  ANow: Int64): string;
var
  LKey: string;
  LResponse: TStoredResponse;
begin
  LKey := AKey;
  try
    if AIdem.Start(AScope, LKey, AFingerprint, ANow, LResponse) then
      Result := 'replay ' + IntToStr(LResponse.Status) + ' ' + LResponse.Body
    else
      Result := 'run';
  except
    on E: EHttpException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Code;
  end;
end;

function NewIdem: TIdempotency;
begin
  Result := TIdempotency.Create(TMemoryIdempotencyStore.Create, 3600, 30);
end;

// A running key (not done, lease until T0 + 30) as IDEMPOTENCY.BY_KEY reads it.
function RunningRow(const AFingerprint: string): IQueryResult;
begin
  Result := TMockQueryResult.SingleRow(BY_KEY_FIELDS, [AFingerprint, 0, T0 + 30, 0, '', '']);
end;

procedure TIdempotencyTests.Key_BareOrQuoted;
begin
  TAssert.AssertEquals('8e03978e-40d5-43e8-bc93-6894a57f9324',
    NormalizeIdempotencyKey('8e03978e-40d5-43e8-bc93-6894a57f9324'));
  TAssert.AssertEquals('abc', NormalizeIdempotencyKey('"abc"'));
  TAssert.AssertEquals('abc', NormalizeIdempotencyKey('  abc '));
  TAssert.AssertEquals(StringOfChar('k', 255), NormalizeIdempotencyKey(StringOfChar('k', 255)));
end;

procedure TIdempotencyTests.Key_Refused;
begin
  TAssert.AssertEquals('', NormalizeIdempotencyKey(''));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('""'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a"b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a\b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey(StringOfChar('k', 256)));
  TAssert.AssertEquals('', NormalizeIdempotencyKey(NON_ASCII_KEY));
end;

procedure TIdempotencyTests.Fingerprint_Sha256OfUtf8;
begin
  // Python: hashlib.sha256('POST /appointments\n{"a":"ção"}'.encode()).hexdigest()
  TAssert.AssertEquals('941016f90f61367f6df09b474399115f06cf087bb7eb3ad155fb4a7d83af812e',
    RequestFingerprint('POST', '/appointments', NON_ASCII_BODY));
  TAssert.AssertFalse(RequestFingerprint('POST', '/a', '{}') = RequestFingerprint('POST', '/b', '{}'));
  TAssert.AssertFalse(RequestFingerprint('POST', '/a', '{}') = RequestFingerprint('PUT', '/a', '{}'));
end;

procedure TIdempotencyTests.HeaderLines_RoundTrip;
var
  LText: string;
  LHeaders: TArray<THttpHeader>;
begin
  LText := HeaderLines([HttpHeader('ETag', '"1"'), HttpHeader('Location', '/cities/1')]);
  TAssert.AssertEquals('ETag: "1"'#10'Location: /cities/1', LText);
  LHeaders := ParseHeaderLines(LText);
  TAssert.AssertEquals(2, Length(LHeaders));
  TAssert.AssertEquals('ETag', LHeaders[0].Name);
  TAssert.AssertEquals('"1"', LHeaders[0].Value);
  TAssert.AssertEquals('/cities/1', LHeaders[1].Value);
  TAssert.AssertEquals('', HeaderLines([]));
  TAssert.AssertEquals(0, Length(ParseHeaderLines('')));
  TAssert.AssertEquals('a line without a name is skipped', 1,
    Length(ParseHeaderLines(': x'#10'A: b'#10'junk')));
end;

procedure TIdempotencyTests.HeaderLines_LineBreakRefused;
var
  LRaised: Boolean;
begin
  LRaised := False;
  try
    HeaderLines([HttpHeader('X-A', 'one'#10'X-B: two')]);
  except
    on E: EArgumentException do
      LRaised := True;
  end;
  TAssert.AssertTrue(LRaised);
end;

procedure TIdempotencyTests.Claim_ThenInFlight_ThenReplay;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('409 idempotency_key_in_flight', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 1));
    LIdem.Complete('demo', 'k1', 201, 'ETag: "1"', '{"id":"x"}');
    TAssert.AssertEquals('replay 201 {"id":"x"}', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 2));
    TAssert.AssertEquals('replay 201 {"id":"x"}', Outcome(LIdem, 'demo', '"k1"', 'f1', T0 + 3));
    TAssert.AssertEquals('another key runs', 'run', Outcome(LIdem, 'demo', 'k2', 'f1', T0 + 3));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_OtherRequest_Is422;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('while running', '422 idempotency_key_reused',
      Outcome(LIdem, 'demo', 'k1', 'f2', T0));
    LIdem.Complete('demo', 'k1', 201, '', '{}');
    TAssert.AssertEquals('once done', '422 idempotency_key_reused',
      Outcome(LIdem, 'demo', 'k1', 'f2', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_LeaseRanOut_TakenOver;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('409 idempotency_key_in_flight', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 29));
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 30));
    TAssert.AssertEquals('a new lease', '409 idempotency_key_in_flight',
      Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 31));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_Expired_IsNew;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    LIdem.Complete('demo', 'k1', 201, '', '{}');
    TAssert.AssertEquals('replay 201 {}', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 3599));
    TAssert.AssertEquals('expired: runs again', 'run', Outcome(LIdem, 'demo', 'k1', 'f2', T0 + 3600));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_ScopesAreApart;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'acme', 'k1', 'f1', T0));
    TAssert.AssertEquals('another scope, the same key', 'run', Outcome(LIdem, 'globex', 'k1', 'f2', T0));
    TAssert.AssertEquals('without a scope', 'run', Outcome(LIdem, '', 'k1', 'f3', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Fail_ClientErrorStored_OtherReleased;
var
  LIdem: TIdempotency;
  E: Exception;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    E := EHttpException.Create(409, 'Taken.', 'slot_unavailable');
    try
      LIdem.Fail('demo', 'k1', E, 'POST', '/appointments');
    finally
      E.Free;
    end;
    TAssert.AssertEquals('replay 409 {"error":"Taken.","code":"slot_unavailable"}',
      Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 1));

    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k2', 'f1', T0));
    E := Exception.Create('connection lost');
    try
      LIdem.Fail('demo', 'k2', E, 'POST', '/appointments');
    finally
      E.Free;
    end;
    TAssert.AssertEquals('released: runs again', 'run', Outcome(LIdem, 'demo', 'k2', 'f1', T0 + 1));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Start_InvalidKey_Is400;
var
  LIdem: TIdempotency;
begin
  LIdem := TIdempotency.Create(TMemoryIdempotencyStore.Create);
  try
    TAssert.AssertEquals('400 invalid_idempotency_key', Outcome(LIdem, 'demo', 'a b', 'f1', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.DbStore_SqlAndParameters;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LStore: IIdempotencyStore;
  LResponse: TStoredResponse;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LStore := TDbIdempotencyStore.Create(LFactory);

  // A new key: the INSERT claims it (one row), after the scope's purge.
  LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 1);
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0, T0 + 30, T0 + 3600, LResponse) = icProceed);
  TAssert.AssertEquals('acme', LMock.LastExecution('IDEMPOTENCY.PURGE').AsString('TENANT_ID'));
  TAssert.AssertEquals(Int64(T0), LMock.LastExecution('IDEMPOTENCY.PURGE').AsInt64('NOW'));
  TAssert.AssertEquals('k1', LMock.LastExecution('IDEMPOTENCY.CLAIM').AsString('IDEM_KEY'));
  TAssert.AssertEquals('f1', LMock.LastExecution('IDEMPOTENCY.CLAIM').AsString('FINGERPRINT'));
  TAssert.AssertEquals(Int64(T0 + 30), LMock.LastExecution('IDEMPOTENCY.CLAIM').AsInt64('LEASE_UNTIL'));
  TAssert.AssertEquals(Int64(T0 + 3600), LMock.LastExecution('IDEMPOTENCY.CLAIM').AsInt64('EXPIRES_AT'));

  // The key exists and has its answer: replayed.
  LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 0);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', TMockQueryResult.SingleRow(BY_KEY_FIELDS,
    ['f1', 1, T0 + 30, 201, 'ETag: "1"', '{"id":"x"}']));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icReplay);
  TAssert.AssertEquals(201, LResponse.Status);
  TAssert.AssertEquals('ETag: "1"', LResponse.Headers);
  TAssert.AssertEquals('{"id":"x"}', LResponse.Body);

  // Another request's fingerprint; then running; then a lease that ran
  // out, taken over by one request.
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f2', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icMismatch);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icInFlight);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  LMock.SetRowsAffected('IDEMPOTENCY.TAKE_OVER', 1);
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 30, T0 + 60, T0 + 3630, LResponse) = icProceed);
  TAssert.AssertEquals(Int64(T0 + 60), LMock.LastExecution('IDEMPOTENCY.TAKE_OVER').AsInt64('LEASE_UNTIL'));
  TAssert.AssertEquals(Int64(T0 + 30), LMock.LastExecution('IDEMPOTENCY.TAKE_OVER').AsInt64('NOW'));

  LResponse.Status := 409;
  LResponse.Headers := '';
  LResponse.Body := '{"error":"Taken."}';
  LStore.Complete('acme', 'k1', LResponse);
  TAssert.AssertEquals(409, LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsInteger('STATUS_CODE'));
  TAssert.AssertEquals('{"error":"Taken."}',
    LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('RESPONSE_BODY'));
  LStore.Release('acme', 'k2');
  TAssert.AssertEquals('k2', LMock.LastExecution('IDEMPOTENCY.RELEASE').AsString('IDEM_KEY'));
end;

initialization
  TDUnitX.RegisterTestFixture(TIdempotencyTests);

end.
