unit PascalApi.IdempotencyTests;

{ Tests for PascalApi.Idempotency: the key, the fingerprint, the stored
  headers, the policy over the memory store (claim, in flight, replay,
  another request, a lease that ran out, expiry, scopes, a failure stored
  or released) and TDbIdempotencyStore's SQL and parameters on
  pascal-db-faa's mock; TIdempotentCall (0.27.0): an answer whose store
  fails after the change committed keeps the key (found by
  pascal-agenda-faa under load: the client got a 409 or a 503 for a
  booking that was made, and a retry ran it again), and CompleteOn in the
  caller's transaction.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. The file is UTF-8
  with a BOM (non-ASCII test data, in typed constants). }

interface

uses
  DUnitX.TestFramework,
  PascalApi.DUnitXCompat,
  SysUtils,
  Variants,
  PascalDb.Interfaces,
  PascalDb.Mock,
  PascalApi.Http,
  PascalApi.Idempotency;

type
  [TestFixture]
  TIdempotencyTests = class
  public
    [Test] procedure Key_BareOrQuoted;
    [Test] procedure Key_Refused;
    [Test] procedure Fingerprint_Sha256OfUtf8;
    [Test] procedure HeaderLines_RoundTrip;
    [Test] procedure HeaderLines_LineBreakRefused;
    [Test] procedure Claim_ThenInFlight_ThenReplay;
    [Test] procedure Claim_OtherRequest_Is422;
    [Test] procedure Claim_LeaseRanOut_TakenOver;
    [Test] procedure Claim_Expired_IsNew;
    [Test] procedure Claim_ScopesAreApart;
    [Test] procedure Fail_ClientErrorStored_OtherReleased;
    [Test] procedure Start_InvalidKey_Is400;
    [Test] procedure RequireKey_BlankIs400;
    [Test] procedure DbStore_SqlAndParameters;
    [Test] procedure Call_CompleteFailsAfterCommit_KeyKept;
    [Test] procedure Call_CompleteFailsAfterCommit_DbStoreNoRelease;
    [Test] procedure Call_FailAfterComplete_KeepsTheAnswer;
    [Test] procedure Call_CompleteOn_InTheCallersTransaction;
    [Test] procedure Call_CompleteOn_RolledBack_Released;
    [Test] procedure Call_CompleteOn_MemoryStoreRefused;
    [Test] procedure Call_WithoutKey_DoesNothing;
  end;

implementation

const
  T0 = 1800000000;
  NON_ASCII_KEY: string = 'ação';
  NON_ASCII_BODY: string = '{"a":"ção"}';
  BY_KEY_FIELDS: array[0..5] of string = ('FINGERPRINT', 'DONE', 'LEASE_UNTIL', 'STATUS_CODE',
    'RESPONSE_HEADERS', 'RESPONSE_BODY');

// Start's outcome as text: 'run', 'replay <status> <body>' or '<status> <code>'.
function Outcome(AIdem: TIdempotency; const AScope, AKey, AFingerprint: string;
  ANow: Int64): string;
var
  LKey: string;
  LResponse: TStoredResponse;
begin
  LKey := AKey;
  try
    if AIdem.Start(AScope, LKey, AFingerprint, ANow, LResponse) then
      Result := 'replay ' + IntToStr(LResponse.Status) + ' ' + LResponse.Body
    else
      Result := 'run';
  except
    on E: EHttpException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Code;
  end;
end;

function RequireOutcome(const AHeader: string): string;
begin
  try
    RequireIdempotencyKey(AHeader);
    Result := 'ok';
  except
    on E: EHttpException do
      Result := IntToStr(E.StatusCode) + ' ' + E.Code + ' ' + E.Message;
  end;
end;

function NewIdem: TIdempotency;
begin
  Result := TIdempotency.Create(TMemoryIdempotencyStore.Create, 3600, 30);
end;

// A running key (not done, lease until T0 + 30) as IDEMPOTENCY.BY_KEY reads it.
function RunningRow(const AFingerprint: string): IQueryResult;
begin
  Result := TMockQueryResult.SingleRow(BY_KEY_FIELDS, [AFingerprint, 0, T0 + 30, 0, '', '']);
end;

type
  /// The memory store, but Complete fails as a pool without a connection
  /// does (pascal-agenda-faa's PostgreSQL run).
  TCompleteFailsStore = class(TInterfacedObject, IIdempotencyStore)
  private
    FInner: IIdempotencyStore;
  public
    constructor Create;
    function Claim(const AScope, AKey, AFingerprint: string; ANow, ALeaseUntil,
      AExpiresAt: Int64; out AResponse: TStoredResponse): TIdempotencyClaim;
    procedure Complete(const AScope, AKey: string; const AResponse: TStoredResponse);
    procedure Release(const AScope, AKey: string);
  end;

constructor TCompleteFailsStore.Create;
begin
  inherited Create;
  FInner := TMemoryIdempotencyStore.Create;
end;

function TCompleteFailsStore.Claim(const AScope, AKey, AFingerprint: string; ANow,
  ALeaseUntil, AExpiresAt: Int64; out AResponse: TStoredResponse): TIdempotencyClaim;
begin
  Result := FInner.Claim(AScope, AKey, AFingerprint, ANow, ALeaseUntil, AExpiresAt, AResponse);
end;

procedure TCompleteFailsStore.Complete(const AScope, AKey: string;
  const AResponse: TStoredResponse);
begin
  raise Exception.Create('no connection in the pool');
end;

procedure TCompleteFailsStore.Release(const AScope, AKey: string);
begin
  FInner.Release(AScope, AKey);
end;

// ACall.Fail with a fresh exception: AStatus's client error, or (0) one
// that isn't an HTTP error.
procedure FailWith(var ACall: TIdempotentCall; AStatus: Integer);
var
  E: Exception;
begin
  if AStatus = 0 then
    E := Exception.Create('connection lost')
  else
    E := EHttpException.Create(AStatus, 'Taken.', 'slot_unavailable');
  try
    ACall.Fail(E);
  finally
    E.Free;
  end;
end;

// AKey claimed for scope 'acme' and fingerprint 'f1' at T0 (on the mock,
// IDEMPOTENCY.CLAIM must affect one row).
function ClaimedCall(AIdem: TIdempotency; const AKey: string): TIdempotentCall;
var
  LKey: string;
  LResponse: TStoredResponse;
begin
  LKey := AKey;
  if AIdem.Start('acme', LKey, 'f1', T0, LResponse) then
    raise Exception.Create('ClaimedCall: replayed');
  Result.Init(AIdem, 'acme', LKey, 'POST', '/appointments');
end;

function CompleteOnOutcome(var ACall: TIdempotentCall): string;
begin
  try
    ACall.CompleteOn(nil, 201, '', '{}');
    Result := 'stored';
  except
    on E: EArgumentException do
      Result := 'refused';
  end;
end;

procedure TIdempotencyTests.Key_BareOrQuoted;
begin
  TAssert.AssertEquals('8e03978e-40d5-43e8-bc93-6894a57f9324',
    NormalizeIdempotencyKey('8e03978e-40d5-43e8-bc93-6894a57f9324'));
  TAssert.AssertEquals('abc', NormalizeIdempotencyKey('"abc"'));
  TAssert.AssertEquals('abc', NormalizeIdempotencyKey('  abc '));
  TAssert.AssertEquals(StringOfChar('k', 255), NormalizeIdempotencyKey(StringOfChar('k', 255)));
end;

procedure TIdempotencyTests.Key_Refused;
begin
  TAssert.AssertEquals('', NormalizeIdempotencyKey(''));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('""'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a"b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey('a\b'));
  TAssert.AssertEquals('', NormalizeIdempotencyKey(StringOfChar('k', 256)));
  TAssert.AssertEquals('', NormalizeIdempotencyKey(NON_ASCII_KEY));
end;

procedure TIdempotencyTests.Fingerprint_Sha256OfUtf8;
begin
  // Python: hashlib.sha256('POST /appointments\n{"a":"ção"}'.encode()).hexdigest()
  TAssert.AssertEquals('941016f90f61367f6df09b474399115f06cf087bb7eb3ad155fb4a7d83af812e',
    RequestFingerprint('POST', '/appointments', NON_ASCII_BODY));
  TAssert.AssertFalse(RequestFingerprint('POST', '/a', '{}') = RequestFingerprint('POST', '/b', '{}'));
  TAssert.AssertFalse(RequestFingerprint('POST', '/a', '{}') = RequestFingerprint('PUT', '/a', '{}'));
end;

procedure TIdempotencyTests.HeaderLines_RoundTrip;
var
  LText: string;
  LHeaders: TArray<THttpHeader>;
begin
  LText := HeaderLines([HttpHeader('ETag', '"1"'), HttpHeader('Location', '/cities/1')]);
  TAssert.AssertEquals('ETag: "1"'#10'Location: /cities/1', LText);
  LHeaders := ParseHeaderLines(LText);
  TAssert.AssertEquals(2, Length(LHeaders));
  TAssert.AssertEquals('ETag', LHeaders[0].Name);
  TAssert.AssertEquals('"1"', LHeaders[0].Value);
  TAssert.AssertEquals('/cities/1', LHeaders[1].Value);
  TAssert.AssertEquals('', HeaderLines([]));
  TAssert.AssertEquals(0, Length(ParseHeaderLines('')));
  TAssert.AssertEquals('a line without a name is skipped', 1,
    Length(ParseHeaderLines(': x'#10'A: b'#10'junk')));
end;

procedure TIdempotencyTests.HeaderLines_LineBreakRefused;
var
  LRaised: Boolean;
begin
  LRaised := False;
  try
    HeaderLines([HttpHeader('X-A', 'one'#10'X-B: two')]);
  except
    on E: EArgumentException do
      LRaised := True;
  end;
  TAssert.AssertTrue(LRaised);
end;

procedure TIdempotencyTests.Claim_ThenInFlight_ThenReplay;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('409 idempotency_key_in_flight', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 1));
    LIdem.Complete('demo', 'k1', 201, 'ETag: "1"', '{"id":"x"}');
    TAssert.AssertEquals('replay 201 {"id":"x"}', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 2));
    TAssert.AssertEquals('replay 201 {"id":"x"}', Outcome(LIdem, 'demo', '"k1"', 'f1', T0 + 3));
    TAssert.AssertEquals('another key runs', 'run', Outcome(LIdem, 'demo', 'k2', 'f1', T0 + 3));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_OtherRequest_Is422;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('while running', '422 idempotency_key_reused',
      Outcome(LIdem, 'demo', 'k1', 'f2', T0));
    LIdem.Complete('demo', 'k1', 201, '', '{}');
    TAssert.AssertEquals('once done', '422 idempotency_key_reused',
      Outcome(LIdem, 'demo', 'k1', 'f2', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_LeaseRanOut_TakenOver;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    TAssert.AssertEquals('409 idempotency_key_in_flight', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 29));
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 30));
    TAssert.AssertEquals('a new lease', '409 idempotency_key_in_flight',
      Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 31));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_Expired_IsNew;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    LIdem.Complete('demo', 'k1', 201, '', '{}');
    TAssert.AssertEquals('replay 201 {}', Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 3599));
    TAssert.AssertEquals('expired: runs again', 'run', Outcome(LIdem, 'demo', 'k1', 'f2', T0 + 3600));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Claim_ScopesAreApart;
var
  LIdem: TIdempotency;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'acme', 'k1', 'f1', T0));
    TAssert.AssertEquals('another scope, the same key', 'run', Outcome(LIdem, 'globex', 'k1', 'f2', T0));
    TAssert.AssertEquals('without a scope', 'run', Outcome(LIdem, '', 'k1', 'f3', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Fail_ClientErrorStored_OtherReleased;
var
  LIdem: TIdempotency;
  E: Exception;
begin
  LIdem := NewIdem;
  try
    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k1', 'f1', T0));
    E := EHttpException.Create(409, 'Taken.', 'slot_unavailable');
    try
      LIdem.Fail('demo', 'k1', E, 'POST', '/appointments');
    finally
      E.Free;
    end;
    TAssert.AssertEquals('replay 409 {"error":"Taken.","code":"slot_unavailable"}',
      Outcome(LIdem, 'demo', 'k1', 'f1', T0 + 1));

    TAssert.AssertEquals('run', Outcome(LIdem, 'demo', 'k2', 'f1', T0));
    E := Exception.Create('connection lost');
    try
      LIdem.Fail('demo', 'k2', E, 'POST', '/appointments');
    finally
      E.Free;
    end;
    TAssert.AssertEquals('released: runs again', 'run', Outcome(LIdem, 'demo', 'k2', 'f1', T0 + 1));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Start_InvalidKey_Is400;
var
  LIdem: TIdempotency;
begin
  LIdem := TIdempotency.Create(TMemoryIdempotencyStore.Create);
  try
    TAssert.AssertEquals('400 invalid_idempotency_key', Outcome(LIdem, 'demo', 'a b', 'f1', T0));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.RequireKey_BlankIs400;
begin
  TApiMessages.Current := TApiMessages.English;
  TAssert.AssertEquals('400 idempotency_key_required Idempotency-Key is required: a new one ' +
    'for each request, such as a UUID.', RequireOutcome(''));
  TAssert.AssertEquals('blank', '400 idempotency_key_required Idempotency-Key is required: a ' +
    'new one for each request, such as a UUID.', RequireOutcome('   '));
  TAssert.AssertEquals('ok', RequireOutcome('k1'));
  // Invalid but present: Start's 400, not this one.
  TAssert.AssertEquals('ok', RequireOutcome('a b'));
end;

procedure TIdempotencyTests.DbStore_SqlAndParameters;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LStore: IIdempotencyStore;
  LResponse: TStoredResponse;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LStore := TDbIdempotencyStore.Create(LFactory);

  // A new key: the INSERT claims it (one row), after the scope's purge.
  LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 1);
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0, T0 + 30, T0 + 3600, LResponse) = icProceed);
  TAssert.AssertEquals('acme', LMock.LastExecution('IDEMPOTENCY.PURGE').AsString('TENANT_ID'));
  TAssert.AssertEquals(Int64(T0), LMock.LastExecution('IDEMPOTENCY.PURGE').AsInt64('NOW'));
  TAssert.AssertEquals('k1', LMock.LastExecution('IDEMPOTENCY.CLAIM').AsString('IDEM_KEY'));
  TAssert.AssertEquals('f1', LMock.LastExecution('IDEMPOTENCY.CLAIM').AsString('FINGERPRINT'));
  TAssert.AssertEquals(Int64(T0 + 30), LMock.LastExecution('IDEMPOTENCY.CLAIM').AsInt64('LEASE_UNTIL'));
  TAssert.AssertEquals(Int64(T0 + 3600), LMock.LastExecution('IDEMPOTENCY.CLAIM').AsInt64('EXPIRES_AT'));

  // The key exists and has its answer: replayed.
  LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 0);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', TMockQueryResult.SingleRow(BY_KEY_FIELDS,
    ['f1', 1, T0 + 30, 201, 'ETag: "1"', '{"id":"x"}']));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icReplay);
  TAssert.AssertEquals(201, LResponse.Status);
  TAssert.AssertEquals('ETag: "1"', LResponse.Headers);
  TAssert.AssertEquals('{"id":"x"}', LResponse.Body);

  // Another request's fingerprint; then running; then a lease that ran
  // out, taken over by one request.
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f2', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icMismatch);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 1, T0 + 31, T0 + 3601, LResponse) = icInFlight);
  LMock.AddResult('IDEMPOTENCY.BY_KEY', RunningRow('f1'));
  LMock.SetRowsAffected('IDEMPOTENCY.TAKE_OVER', 1);
  TAssert.AssertTrue(LStore.Claim('acme', 'k1', 'f1', T0 + 30, T0 + 60, T0 + 3630, LResponse) = icProceed);
  TAssert.AssertEquals(Int64(T0 + 60), LMock.LastExecution('IDEMPOTENCY.TAKE_OVER').AsInt64('LEASE_UNTIL'));
  TAssert.AssertEquals(Int64(T0 + 30), LMock.LastExecution('IDEMPOTENCY.TAKE_OVER').AsInt64('NOW'));

  LResponse.Status := 409;
  LResponse.Headers := '';
  LResponse.Body := '{"error":"Taken."}';
  LStore.Complete('acme', 'k1', LResponse);
  TAssert.AssertEquals(409, LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsInteger('STATUS_CODE'));
  TAssert.AssertEquals('{"error":"Taken."}',
    LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('RESPONSE_BODY'));
  LStore.Release('acme', 'k2');
  TAssert.AssertEquals('k2', LMock.LastExecution('IDEMPOTENCY.RELEASE').AsString('IDEM_KEY'));
end;

// What pascal-agenda-faa measured: the change committed, then Complete
// failed. The answer goes out (Complete says False, never raises), Fail
// keeps the key, and a retry is "in flight" until the lease runs out,
// never a second run at once. (Until 0.26.0 Fail released it: 'run'.)
procedure TIdempotencyTests.Call_CompleteFailsAfterCommit_KeyKept;
var
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
begin
  LIdem := TIdempotency.Create(TCompleteFailsStore.Create, 3600, 30);
  try
    LCall := ClaimedCall(LIdem, 'k1');
    TAssert.AssertFalse(LCall.Complete(201, '', '{"id":"x"}'));
    TAssert.AssertEquals('Exception: no connection in the pool', LCall.CompleteError);
    TAssert.AssertTrue(LCall.State = icsDone);
    FailWith(LCall, 0);
    TAssert.AssertEquals('kept', '409 idempotency_key_in_flight',
      Outcome(LIdem, 'acme', 'k1', 'f1', T0 + 1));
    TAssert.AssertEquals('the lease ran out', 'run', Outcome(LIdem, 'acme', 'k1', 'f1', T0 + 30));
  finally
    LIdem.Free;
  end;
end;

// The same on the database store: SQLite's writer lock ran out under
// COMPLETE (ELockConflictException, a 409 to the client until 0.26.0).
procedure TIdempotencyTests.Call_CompleteFailsAfterCommit_DbStoreNoRelease;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LIdem := TIdempotency.Create(TDbIdempotencyStore.Create(LFactory), 3600, 30);
  try
    LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 1);
    LCall := ClaimedCall(LIdem, 'k1');
    LMock.AddFailure('IDEMPOTENCY.COMPLETE', ELockConflictException, 'database is locked');
    TAssert.AssertFalse(LCall.Complete(201, '', '{"id":"x"}'));
    TAssert.AssertTrue(LCall.CompleteError, Pos('database is locked', LCall.CompleteError) > 0);
    FailWith(LCall, 409);
    TAssert.AssertEquals('no release', 0, LMock.ExecutionCount('IDEMPOTENCY.RELEASE'));
    TAssert.AssertEquals('no error stored', 1, LMock.ExecutionCount('IDEMPOTENCY.COMPLETE'));
  finally
    LIdem.Free;
  end;
end;

// Something raised after the answer was stored: the answer stays, never a
// client error over it.
procedure TIdempotencyTests.Call_FailAfterComplete_KeepsTheAnswer;
var
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
begin
  LIdem := NewIdem;
  try
    LCall := ClaimedCall(LIdem, 'k1');
    TAssert.AssertTrue(LCall.Complete(201, '', '{"id":"x"}'));
    TAssert.AssertEquals('', LCall.CompleteError);
    FailWith(LCall, 409);
    TAssert.AssertEquals('replay 201 {"id":"x"}', Outcome(LIdem, 'acme', 'k1', 'f1', T0 + 1));
  finally
    LIdem.Free;
  end;
end;

// CompleteOn: COMPLETE on the caller's query, in its transaction; nothing
// written after the commit, and a later failure changes nothing.
procedure TIdempotencyTests.Call_CompleteOn_InTheCallersTransaction;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LIdem := TIdempotency.Create(TDbIdempotencyStore.Create(LFactory), 3600, 30);
  try
    LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 1);
    LCall := ClaimedCall(LIdem, 'k1');
    LTx := LFactory.GetPool.AcquireQuery(LQuery);
    LTx.StartTransaction;
    LCall.CompleteOn(LQuery, 201, 'ETag: "1"', '{"id":"x"}');
    LTx.Commit;
    LTx := nil;
    LQuery := nil;
    TAssert.AssertTrue(LCall.State = icsStoredOn);
    TAssert.AssertEquals(201, LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsInteger('STATUS_CODE'));
    TAssert.AssertEquals('acme', LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('TENANT_ID'));
    TAssert.AssertEquals('k1', LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('IDEM_KEY'));
    TAssert.AssertEquals('ETag: "1"',
      LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('RESPONSE_HEADERS'));
    TAssert.AssertEquals('{"id":"x"}',
      LMock.LastExecution('IDEMPOTENCY.COMPLETE').AsString('RESPONSE_BODY'));
    TAssert.AssertTrue('already stored', LCall.Complete(201, 'ETag: "1"', '{"id":"x"}'));
    FailWith(LCall, 409);
    TAssert.AssertEquals('once', 1, LMock.ExecutionCount('IDEMPOTENCY.COMPLETE'));
    TAssert.AssertEquals(0, LMock.ExecutionCount('IDEMPOTENCY.RELEASE'));
  finally
    LIdem.Free;
  end;
end;

// The commit after CompleteOn failed: the answer rolled back with the
// change, so the key is released (RELEASE leaves an answered key alone),
// and a client error is never stored over an answer that may have
// committed.
procedure TIdempotencyTests.Call_CompleteOn_RolledBack_Released;
var
  LMock: TMockDBFactory;
  LFactory: IDBFactory;
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  LMock := TMockDBFactory.Create;
  LFactory := LMock;
  LIdem := TIdempotency.Create(TDbIdempotencyStore.Create(LFactory), 3600, 30);
  try
    LMock.SetRowsAffected('IDEMPOTENCY.CLAIM', 1);
    LCall := ClaimedCall(LIdem, 'k1');
    LTx := LFactory.GetPool.AcquireQuery(LQuery);
    LTx.StartTransaction;
    LCall.CompleteOn(LQuery, 201, '', '{"id":"x"}');
    LTx.Rollback;
    LTx := nil;
    LQuery := nil;
    FailWith(LCall, 409);
    TAssert.AssertEquals(1, LMock.ExecutionCount('IDEMPOTENCY.RELEASE'));
    TAssert.AssertEquals('k1', LMock.LastExecution('IDEMPOTENCY.RELEASE').AsString('IDEM_KEY'));
    TAssert.AssertEquals('no 409 stored', 1, LMock.ExecutionCount('IDEMPOTENCY.COMPLETE'));
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Call_CompleteOn_MemoryStoreRefused;
var
  LIdem: TIdempotency;
  LCall: TIdempotentCall;
begin
  LIdem := NewIdem;
  try
    LCall := ClaimedCall(LIdem, 'k1');
    TAssert.AssertEquals('refused', CompleteOnOutcome(LCall));
    TAssert.AssertTrue(LCall.State = icsOpen);
  finally
    LIdem.Free;
  end;
end;

procedure TIdempotencyTests.Call_WithoutKey_DoesNothing;
var
  LCall: TIdempotentCall;
begin
  LCall.Init(nil, '', '', 'POST', '/appointments');
  TAssert.AssertTrue(LCall.Complete(201, '', '{}'));
  TAssert.AssertEquals('stored', CompleteOnOutcome(LCall));
  FailWith(LCall, 0);
  TAssert.AssertEquals('', LCall.Key);
end;

initialization
  TDUnitX.RegisterTestFixture(TIdempotencyTests);

end.
