    </Target>
    <Target Name="OtlpNoDb:Clean">
        <MSBuild Projects="tests\Deps\OtlpNoDb.dproj" Targets="Clean"/>
    </Target>
    <Target Name="OtlpNoDb:Make">
        <MSBuild Projects="tests\Deps\OtlpNoDb.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="PascalApi_UnitTests;ApiSample;DbApiSample;TenantApiSample;OtlpNoDb"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="PascalApi_UnitTests:Clean;ApiSample:Clean;DbApiSample:Clean;TenantApiSample:Clean;OtlpNoDb:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="PascalApi_UnitTests:Make;ApiSample:Make;DbApiSample:Make;TenantApiSample:Make;OtlpNoDb:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
