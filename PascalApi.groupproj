<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{2420469A-54AC-4DE3-92DF-293A249EA3AC}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="tests\Unit\PascalApi.UnitTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="samples\01-api\ApiSample.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="samples\02-db\DbApiSample.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="samples\03-tenants\TenantApiSample.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="tests\Deps\OtlpNoDb.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="PascalApi_UnitTests">
        <MSBuild Projects="tests\Unit\PascalApi.UnitTests.dproj"/>
    </Target>
    <Target Name="PascalApi_UnitTests:Clean">
        <MSBuild Projects="tests\Unit\PascalApi.UnitTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PascalApi_UnitTests:Make">
        <MSBuild Projects="tests\Unit\PascalApi.UnitTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="ApiSample">
        <MSBuild Projects="samples\01-api\ApiSample.dproj"/>
    </Target>
    <Target Name="ApiSample:Clean">
        <MSBuild Projects="samples\01-api\ApiSample.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ApiSample:Make">
        <MSBuild Projects="samples\01-api\ApiSample.dproj" Targets="Make"/>
    </Target>
    <Target Name="DbApiSample">
        <MSBuild Projects="samples\02-db\DbApiSample.dproj"/>
    </Target>
    <Target Name="DbApiSample:Clean">
        <MSBuild Projects="samples\02-db\DbApiSample.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DbApiSample:Make">
        <MSBuild Projects="samples\02-db\DbApiSample.dproj" Targets="Make"/>
    </Target>
    <Target Name="TenantApiSample">
        <MSBuild Projects="samples\03-tenants\TenantApiSample.dproj"/>
    </Target>
    <Target Name="TenantApiSample:Clean">
        <MSBuild Projects="samples\03-tenants\TenantApiSample.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TenantApiSample:Make">
        <MSBuild Projects="samples\03-tenants\TenantApiSample.dproj" Targets="Make"/>
